<script>
    function openDemandeModal() {
        document.getElementById('demandeModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
    function closeDemandeModal() {
        document.getElementById('demandeModal').style.display = 'none';
        document.body.style.overflow = '';
    }

    function openShowModal(id) {
        document.getElementById('showModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';

        fetch(`/formateur/demandes/${id}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        })
        .then(r => r.json())
        .then(data => {
            document.getElementById('showContent').innerHTML = data.html;
        })
        .catch(err => {
            document.getElementById('showContent').innerHTML =
                '<div class="text-center py-8 text-red-500">Erreur</div>';
        });
    }
    function closeShowModal() {
        document.getElementById('showModal').style.display = 'none';
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            closeDemandeModal();
            closeShowModal();
        }
    });
</script>

