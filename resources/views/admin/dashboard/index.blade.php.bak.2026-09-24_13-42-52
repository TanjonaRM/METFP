<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        // ============================================================
        // INITIALISATION DES GRAPHIQUES
        // ============================================================
        const initialData = {
            etablissements: @json($formateursParEtablissement ?? []),
            evolution:      @json($evolutionAffectations ?? []),
        };

        // Options communes pour empêcher le débordement
        const commonOptions = {
            chart: {
                height: '100%',           // ⚡ Prend toute la hauteur du parent (fixée à 280px)
                width: '100%',
                toolbar: { show: false },
                fontFamily: 'Inter, sans-serif',
                animations: {
                    enabled: true,
                    easing: 'easeinout',
                    speed: 400,
                    dynamicAnimation: {
                        enabled: true,
                        speed: 350,
                    },
                },
            },
            grid: {
                borderColor: '#f1f5f9',
                strokeDashArray: 3,
                padding: { top: 0, right: 8, bottom: 0, left: 8 },
            },
            noData: {
                text: 'Aucune donnée',
                style: { fontSize: '13px', color: '#a1a1aa' },
            },
        };

        // ---- GRAPHIQUE 1 : Barres horizontales ----
        const chartEtablissements = new ApexCharts(
            document.querySelector('#chart-etablissements'),
            {
                ...commonOptions,
                chart: { ...commonOptions.chart, type: 'bar' },
                series: [{
                    name: 'Formateurs',
                    data: initialData.etablissements.map(e => e.count),
                }],
                xaxis: {
                    categories: initialData.etablissements.map(e => e.nom),
                    labels: { style: { fontSize: '11px', colors: '#71717a' } },
                },
                yaxis: {
                    labels: { style: { fontSize: '11px', colors: '#71717a' } },
                },
                plotOptions: {
                    bar: { horizontal: true, borderRadius: 6, barHeight: '55%' },
                },
                colors: ['#059669'],
                dataLabels: {
                    enabled: true,
                    style: { fontSize: '11px', fontWeight: 600, colors: ['#ffffff'] },
                },
                grid: { ...commonOptions.grid, xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } } },
                tooltip: { y: { formatter: val => `${val} formateur(s)` } },
            }
        );
        chartEtablissements.render();

        // ---- GRAPHIQUE 2 : Courbe (area) ----
        const chartEvolution = new ApexCharts(
            document.querySelector('#chart-evolution'),
            {
                ...commonOptions,
                chart: { ...commonOptions.chart, type: 'area' },
                series: [{
                    name: 'Affectations',
                    data: initialData.evolution.map(e => e.count),
                }],
                xaxis: {
                    categories: initialData.evolution.map(e => e.label),
                    labels: { style: { fontSize: '11px', colors: '#71717a' } },
                    axisBorder: { show: false },
                    axisTicks: { show: false },
                },
                yaxis: {
                    labels: { style: { fontSize: '11px', colors: '#71717a' } },
                    min: 0,
                    forceNiceScale: true,
                },
                colors: ['#059669'],
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.4,
                        opacityTo: 0.05,
                        stops: [0, 100],
                    },
                },
                stroke: { curve: 'smooth', width: 3 },
                markers: {
                    size: 5,
                    colors: ['#059669'],
                    strokeColors: '#ffffff',
                    strokeWidth: 2,
                    hover: { size: 7 },
                },
                dataLabels: { enabled: false },
                tooltip: { y: { formatter: val => `${val} affectation(s)` } },
            }
        );
        chartEvolution.render();

        // ============================================================
        // AJAX POLLING — toutes les 10 secondes
        // ============================================================
        const POLL_INTERVAL = 10000; // 10 secondes
        const ENDPOINT = '{{ route("admin.dashboard.data") }}';
        const indicator = document.getElementById('refresh-indicator');

        async function refreshDashboard() {
            try {
                const response = await fetch(ENDPOINT, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json',
                    },
                });

                if (!response.ok) throw new Error('HTTP ' + response.status);

                const data = await response.json();

                // ---- Mise à jour des KPI ----
                document.querySelectorAll('[data-kpi]').forEach(el => {
                    const key = el.getAttribute('data-kpi');
                    if (data.stats[key] !== undefined) {
                        animateValue(el, parseInt(el.textContent) || 0, data.stats[key]);
                    }
                });

                // ---- Mise à jour des statuts (carte Formateurs) ----
                document.querySelectorAll('[data-statut]').forEach(el => {
                    const key = el.getAttribute('data-statut');
                    if (data.formateursParStatut[key] !== undefined) {
                        animateValue(el, parseInt(el.textContent) || 0, data.formateursParStatut[key]);
                    }
                });

                // ---- Mise à jour GRAPHIQUE 1 ----
                chartEtablissements.updateOptions({
                    xaxis: { categories: data.formateursParEtablissement.map(e => e.nom) },
                }, false, false);
                chartEtablissements.updateSeries([{
                    name: 'Formateurs',
                    data: data.formateursParEtablissement.map(e => e.count),
                }]);

                // ---- Mise à jour GRAPHIQUE 2 ----
                chartEvolution.updateOptions({
                    xaxis: { categories: data.evolutionAffectations.map(e => e.label) },
                }, false, false);
                chartEvolution.updateSeries([{
                    name: 'Affectations',
                    data: data.evolutionAffectations.map(e => e.count),
                }]);

                // ---- Mise à jour du tableau ----
                updateTableAffectations(data.dernieresAffectations);

                // ---- Feedback visuel ----
                if (indicator) {
                    indicator.style.color = '#10b981';
                    setTimeout(() => indicator.style.color = '#71717a', 500);
                }
            } catch (error) {
                console.warn('⚠️ Rafraîchissement impossible :', error.message);
                if (indicator) indicator.style.color = '#ef4444';
            }
        }

        /**
         * Animation fluide de compteur (0 → N)
         */
        function animateValue(el, start, end, duration = 600) {
            if (start === end) return;

            const range = end - start;
            const startTime = performance.now();

            function step(now) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
                el.textContent = Math.round(start + range * eased);
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

        /**
         * Mise à jour du tableau des affectations
         */
        function updateTableAffectations(affectations) {
            const tbody = document.getElementById('table-affectations');
            if (!tbody) return;

            if (!affectations || affectations.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-8 text-slate-400 text-sm">
                            Aucune affectation
                        </td>
                    </tr>`;
                return;
            }

            tbody.innerHTML = affectations.map(a => {
                let badge = '<span class="badge-warning">Suspendu</span>';
                if (a.statut === 'actif') badge = '<span class="badge-success">Actif</span>';
                else if (a.statut === 'termine' || a.statut === 'terminé') badge = '<span class="badge-gray">Terminé</span>';

                return `
                    <tr>
                        <td class="font-semibold">${escapeHtml(a.formateur)}</td>
                        <td>${escapeHtml(a.filiere)}</td>
                        <td>${escapeHtml(a.etablissement)}</td>
                        <td class="text-xs">${escapeHtml(a.date_debut)} → ${escapeHtml(a.date_fin)}</td>
                        <td>${badge}</td>
                    </tr>
                `;
            }).join('');
        }

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // ---- Lancer le polling ----
        setInterval(refreshDashboard, POLL_INTERVAL);
        console.log('✅ Dashboard temps réel actif — rafraîchissement toutes les ' + (POLL_INTERVAL / 1000) + 's');
    });
</script>

