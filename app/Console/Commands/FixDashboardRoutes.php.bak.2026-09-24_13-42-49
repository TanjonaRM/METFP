<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixDashboardRoutes extends Command
{
    protected $signature = 'project:fix-dashboard-routes
                            {--backup : Sauvegarder le fichier (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Remplace formateur.affectations.* par formateur.demandes.* dans le dashboard formateur';

    public function handle(): int
    {
        $this->info("🔧 Correction des routes dans le dashboard formateur");
        $this->newLine();

        $path = 'resources/views/formateur/dashboard/index.blade.php';
        $fullPath = base_path($path);

        if (!File::exists($fullPath)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
            File::copy($fullPath, $backupPath);
            $this->line("  💾 Backup : " . basename($backupPath));
        }

        $content = File::get($fullPath);
        $originalSize = strlen($content);
        $modified = false;

        // ============================================================
        // Remplacements
        // ============================================================
        $replacements = [
            "route('formateur.affectations.index')"   => "route('formateur.demandes.index')",
            "route('formateur.affectations.show', "   => "route('formateur.demandes.show', ",
            "formateur.affectations"                  => "formateur.demandes",
        ];

        foreach ($replacements as $old => $new) {
            $count = substr_count($content, $old);
            if ($count > 0) {
                $content = str_replace($old, $new, $content);
                $this->line("  ✅ \"{$old}\" → \"{$new}\" ({$count} occurrence(s))");
                $modified = true;
            }
        }

        if (!$modified) {
            $this->warn("  ⚠️  Aucune occurrence trouvée");
            return self::SUCCESS;
        }

        File::put($fullPath, $content);

        $newSize = strlen($content);
        $this->line("  ✅ {$path} mis à jour");

        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : routes corrigées");

        return self::SUCCESS;
    }
}