<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Facades\Artisan;

class FixAllRemainingIssues extends Command
{
    protected $signature = 'fix:all-issues';
    protected $description = 'Corrige TOUS les problèmes restants du projet';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🚀 CORRECTION TOTALE DU PROJET                         ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');

        // ═══════════════════════════════════════════════
        // 1. Vider les logs obsolètes
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 1/6 — Nettoyage des logs obsolètes');
        $this->clearLogs();

        // ═══════════════════════════════════════════════
        // 2. Nettoyer les 7 fichiers .bak
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 2/6 — Nettoyage des fichiers .bak');
        $this->call('project:clean-bak', ['--force' => true]);

        // ═══════════════════════════════════════════════
        // 3. Corriger UserModel
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 3/6 — Correction UserModel');
        $this->fixUserModel();

        // ═══════════════════════════════════════════════
        // 4. Corriger les Form Requests manquants
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 4/6 — Correction des Form Requests');
        $this->fixFormRequests();

        // ═══════════════════════════════════════════════
        // 5. Exécuter la migration en attente
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 5/6 — Exécution migration en attente');
        $this->runPendingMigration();

        // ═══════════════════════════════════════════════
        // 6. Caches + audit final
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 6/6 — Nettoyage + Audit final');
        Artisan::call('view:clear');
        Artisan::call('optimize:clear');
        $this->info('   ✅ Caches vidés');

        $this->line('');
        $this->line('═══════════════════════════════════════════════════════════');
        $this->line('');

        // Relancer l'audit
        $this->call('audit:full');

        return self::SUCCESS;
    }

    // ═══════════════════════════════════════════════════════
    // 1. VIDER LES LOGS
    // ═══════════════════════════════════════════════════════
    private function clearLogs(): void
    {
        $logPath = storage_path('logs/laravel.log');

        if (!File::exists($logPath)) {
            $this->info('   ✅ Aucun log à nettoyer');
            return;
        }

        $size = File::size($logPath);
        $backup = $logPath . '.bak.' . date('Y-m-d_His');
        File::copy($logPath, $backup);
        File::put($logPath, '');

        $this->info('   ✅ Log vidé (' . round($size / 1024) . ' Ko → 0)');
        $this->line('      💾 Backup : ' . basename($backup));
    }

    // ═══════════════════════════════════════════════════════
    // 3. CORRIGER USERMODEL
    // ═══════════════════════════════════════════════════════
    private function fixUserModel(): void
    {
        $path = app_path('Infrastructure/Persistence/Eloquent/Models/UserModel.php');

        if (!File::exists($path)) {
            $this->warn('   ⏭️  UserModel.php introuvable');
            return;
        }

        $content = File::get($path);

        if (str_contains($content, '$fillable') || str_contains($content, '$guarded')) {
            $this->warn('   ⏭️  $fillable ou $guarded déjà défini');
            return;
        }

        // Backup
        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));

        // Insérer $fillable après la déclaration de la classe
        $insert = <<<'PHP'

    /**
     * Attributs mass-assignables.
     */
    protected $fillable = [
        'name',
        'email',
        'password',
        'role',
        'statut',
    ];

PHP;

        // Trouver la première { de la classe
        if (preg_match('/class\s+UserModel\s+extends\s+\w+\s*\{/', $content, $m, PREG_OFFSET_CAPTURE)) {
            $pos = $m[0][1] + strlen($m[0][0]);
            $content = substr($content, 0, $pos) . $insert . substr($content, $pos);
            File::put($path, $content);
            $this->info('   ✅ UserModel : $fillable ajouté');
        } else {
            $this->warn('   ⚠️  Impossible d\'insérer $fillable automatiquement');
        }
    }

    // ═══════════════════════════════════════════════════════
    // 4. CORRIGER LES FORM REQUESTS
    // ═══════════════════════════════════════════════════════
    private function fixFormRequests(): void
    {
        $requests = [
            'Http/Requests/Auth/Formateur/LoginFormateurRequest.php'        => 'login',
            'Http/Requests/Auth/Formateur/RegisterFormateurRequest.php'     => 'register',
            'Http/Requests/Filiere/StoreFiliereRequest.php'                 => 'store',
            'Http/Requests/Filiere/UpdateFiliereRequest.php'                => 'update',
            'Http/Requests/Niveau/StoreNiveauRequest.php'                   => 'store',
            'Http/Requests/Niveau/UpdateNiveauRequest.php'                  => 'update',
            'Http/Requests/Secteur/StoreSecteurRequest.php'                 => 'store',
            'Http/Requests/Secteur/UpdateSecteurRequest.php'                => 'update',
            'Http/Requests/Session/StoreSessionRequest.php'                 => 'store',
            'Http/Requests/Session/UpdateSessionRequest.php'                => 'update',
        ];

        $fixed = 0;
        $skipped = 0;

        foreach ($requests as $relPath => $action) {
            $path = app_path($relPath);

            if (!File::exists($path)) {
                $this->warn("   ⏭️  Introuvable : {$relPath}");
                $skipped++;
                continue;
            }

            $content = File::get($path);

            // Vérifier si authorize() et rules() existent
            $hasAuthorize = preg_match('/public function authorize\s*\(/', $content);
            $hasRules     = preg_match('/public function rules\s*\(/', $content);

            if ($hasAuthorize && $hasRules) {
                $this->line("   ⏭️  {$relPath} → déjà OK");
                $skipped++;
                continue;
            }

            // Backup
            File::copy($path, $path . '.bak.' . date('Y-m-d_His'));

            // Injecter les méthodes manquantes
            $content = $this->injectMethods($content, $hasAuthorize, $hasRules, $action);

            File::put($path, $content);
            $this->info("   ✅ Corrigé : {$relPath}");
            $fixed++;
        }

        $this->line('');
        $this->line("   📊 Bilan : {$fixed} corrigés, {$skipped} skippés");
    }

    private function injectMethods(string $content, bool $hasAuthorize, bool $hasRules, string $action): string
    {
        $methods = '';

        if (!$hasAuthorize) {
            $methods .= <<<'PHP'

    public function authorize(): bool
    {
        return auth('admin')->check() || auth('formateur')->check();
    }
PHP;
        }

        if (!$hasRules) {
            $methods .= <<<'PHP'

    public function rules(): array
    {
        return [
            // TODO : ajoutez vos règles de validation ici
        ];
    }
PHP;
        }

        // Insérer avant la dernière }
        $pos = strrpos($content, '}');
        if ($pos !== false) {
            $content = substr($content, 0, $pos) . $methods . "\n" . substr($content, $pos);
        }

        return $content;
    }

    // ═══════════════════════════════════════════════════════
    // 5. MIGRATION EN ATTENTE
    // ═══════════════════════════════════════════════════════
    private function runPendingMigration(): void
    {
        // Vérifier si la colonne statut accepte 'suspendu'
        try {
            $hasMigration = \DB::table('migrations')
                ->where('migration', 'like', '%add_suspendu_to_formateurs_statut%')
                ->exists();

            if ($hasMigration) {
                $this->info('   ✅ Migration déjà exécutée');
                return;
            }

            // Vérifier si la colonne existe déjà (peut-être ajoutée manuellement)
            $columns = \Schema::getColumnListing('formateurs');
            if (in_array('statut', $columns)) {
                $this->warn('   ⏭️  Colonne "statut" existe déjà — migration marquée comme exécutée');
                \DB::table('migrations')->insert([
                    'migration' => '2026_09_19_183718_add_suspendu_to_formateurs_statut',
                    'batch'     => \DB::table('migrations')->max('batch') + 1,
                ]);
                return;
            }

            // Exécuter la migration
            Artisan::call('migrate', ['--force' => true]);
            $this->info('   ✅ Migration exécutée');
        } catch (\Throwable $e) {
            $this->warn('   ⚠️  Erreur migration : ' . $e->getMessage());
        }
    }
}