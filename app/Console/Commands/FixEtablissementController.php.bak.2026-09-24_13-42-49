<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixEtablissementController extends Command
{
    protected $signature = 'fix:etablissement-controller
                            {--check : Vérifier seulement, sans modifier}';

    protected $description = 'Corrige EtablissementController : $data → $validated + code nullable';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔧 CORRECTION ETABLISSEMENT CONTROLLER                  ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');

        $path = app_path('Http/Controllers/Admin/EtablissementController.php');

        if (!File::exists($path)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        $content = File::get($path);
        $original = $content;

        // ═══════════════════════════════════════════════
        // ÉTAT ACTUEL
        // ═══════════════════════════════════════════════
        $this->line('▶ 1. État actuel');

        $hasData = str_contains($content, '$data[');
        $hasRequired = str_contains($content, "'code' => 'required");
        $hasNullable = str_contains($content, "'code' => 'nullable");

        $this->line('   Taille : ' . File::size($path) . ' octets');
        $this->line('   ' . ($hasData ? '❌' : '✅') . ' Contient $data[');
        $this->line('   ' . ($hasRequired ? '❌' : '✅') . ' code est required');
        $this->line('   ' . ($hasNullable ? '✅' : '⏳') . ' code est nullable');

        if ($this->option('check')) {
            $this->line('');
            $this->info('👉 Mode --check : aucun fichier modifié.');
            return self::SUCCESS;
        }

        // Si rien à faire
        if (!$hasData && $hasNullable) {
            $this->line('');
            $this->info('✅ Déjà corrigé, rien à faire.');
            return self::SUCCESS;
        }

        // ═══════════════════════════════════════════════
        // BACKUP
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 2. Backup');

        $backupPath = $path . '.bak.' . date('Y-m-d_His');
        File::copy($path, $backupPath);
        $this->info('   💾 ' . basename($backupPath));

        $modifications = 0;

        // ═══════════════════════════════════════════════
        // CORRECTION 1 : $data → $validated
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 3. Correction $data → $validated');

        if ($hasData) {
            // Remplacer toutes les occurrences de $data[ par $validated[
            // MAIS uniquement dans la méthode store() (pour ne pas casser d'autres méthodes)
            $count = 0;
            $content = preg_replace_callback(
                '/\$data\[/',
                function ($m) use (&$count) {
                    $count++;
                    return '$validated[';
                },
                $content
            );

            $this->info("   ✅ {$count} occurrence(s) corrigée(s) : \$data → \$validated");
            $modifications++;
        } else {
            $this->line('   ⏭️  Aucun $data[ trouvé');
        }

        // ═══════════════════════════════════════════════
        // CORRECTION 2 : 'code' => 'required' → 'nullable'
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 4. Correction validation code');

        $patterns = [
            "/'code'\s*=>\s*'required\|string\|unique:etablissements,code'/",
            "/'code'\s*=>\s*'required\|unique:etablissements,code\|string'/",
            "/'code'\s*=>\s*'required\|string'/",
        ];

        $fixed = false;
        foreach ($patterns as $pattern) {
            if (preg_match($pattern, $content)) {
                $content = preg_replace(
                    $pattern,
                    "'code' => 'nullable|string|unique:etablissements,code'",
                    $content
                );
                $this->info("   ✅ 'code' rendu nullable");
                $modifications++;
                $fixed = true;
                break;
            }
        }

        if (!$fixed && !$hasNullable) {
            $this->warn('   ⚠️  Pattern de validation code introuvable');
            $this->line('   👉 Vérifiez manuellement la ligne du champ code');
        } elseif ($hasNullable) {
            $this->line('   ⏭️  Déjà nullable');
        }

        // ═══════════════════════════════════════════════
        // CORRECTION 3 : Vérifier import NotificationService
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 5. Vérification import NotificationService');

        if (str_contains($content, 'use App\Services\NotificationService;')) {
            $this->info('   ✅ Import présent');
        } elseif (str_contains($content, 'NotificationService::')) {
            $this->warn('   ⚠️  NotificationService utilisé mais PAS importé');

            // Ajouter l'import après le dernier use
            if (preg_match_all('/^use\s+[^;]+;/m', $content, $matches, PREG_OFFSET_CAPTURE)) {
                $lastUse = end($matches[0]);
                $insertPos = $lastUse[1] + strlen($lastUse[0]);

                $content = substr($content, 0, $insertPos)
                    . "\nuse App\\Services\\NotificationService;"
                    . substr($content, $insertPos);

                $this->info('   ✅ Import ajouté automatiquement');
                $modifications++;
            }
        } else {
            $this->line('   ⏭️  NotificationService non utilisé');
        }

        // ═══════════════════════════════════════════════
        // SAUVEGARDE
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 6. Sauvegarde');

        if ($content === $original) {
            $this->warn('   ⚠️  Aucune modification');
            return self::SUCCESS;
        }

        File::put($path, $content);
        $this->info('   ✅ Fichier enregistré');
        $this->line('   📦 Nouvelle taille : ' . File::size($path) . ' octets');

        // ═══════════════════════════════════════════════
        // VÉRIFICATION SYNTAXE
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 7. Vérification syntaxe PHP');

        $output = [];
        $returnCode = 0;
        exec('php -l "' . $path . '" 2>&1', $output, $returnCode);

        if ($returnCode === 0) {
            $this->info('   ✅ Syntaxe PHP valide');
        } else {
            $this->error('   ❌ ERREUR SYNTAXE :');
            foreach ($output as $o) {
                $this->line('      ' . $o);
            }
            $this->warn('   👉 Restaurez le backup : ' . basename($backupPath));
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // VÉRIFICATION FINALE
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 8. Vérification finale');

        $final = File::get($path);

        $this->line('   ' . (str_contains($final, '$data[') ? '❌' : '✅') . ' Plus de $data[');
        $this->line('   ' . (str_contains($final, "'code' => 'required") ? '❌' : '✅') . ' Plus de code required');

        // ═══════════════════════════════════════════════
        // VIDAGE CACHES
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 9. Vidage des caches');
        $this->call('optimize:clear');
        $this->call('view:clear');
        $this->call('config:clear');
        $this->info('   ✅ Caches vidés');

        // ═══════════════════════════════════════════════
        // RÉSUMÉ
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 CORRECTION TERMINÉE                                  ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line("📊 {$modifications} modification(s) appliquée(s)");
        $this->line('');
        $this->line('👉 Testez maintenant :');
        $this->line('   1. http://localhost:8000/admin/etablissements');
        $this->line('   2. Cliquez "Ajouter"');
        $this->line('   3. Type : CFP');
        $this->line('   4. Nom : CFP AMBILOBE');
        $this->line('   5. Région : Analamanga');
        $this->line('   6. Statut : Actif');
        $this->line('   7. Enregistrer → code auto-généré : CFP-AMBILOBE ✅');

        return self::SUCCESS;
    }
}