namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixFormateurModal extends Command
{
    protected $signature = 'fix:formateur-modal {--force : Écrase les fichiers existants}';
    protected $description = 'Corrige le modal "Ajouter un formateur"';

    public function handle(): int
    {
        $base = resource_path('views/admin/formateurs');
        $partials = $base . '/partials';

        if (!File::exists($partials)) {
            File::makeDirectory($partials, 0755, true);
            $this->info("📁 Créé : resources/views/admin/formateurs/partials/");
        }

        // 1. Créer le partial form
        $formPath = $partials . '/form.blade.php';
        if (!File::exists($formPath) || $this->option('force')) {
            File::put($formPath, $this->getFormBlade());
            $this->info("✅ Créé : partials/form.blade.php");
        }

        // 2. Créer le partial modal
        $modalPath = $partials . '/modal-create.blade.php';
        if (!File::exists($modalPath) || $this->option('force')) {
            File::put($modalPath, $this->getModalBlade());
            $this->info("✅ Créé : partials/modal-create.blade.php");
        }

        $this->newLine();
        $this->warn("⚠️  ÉTAPE MANUELLE REQUISE :");
        $this->line("   Ajoutez ces 3 lignes dans index.blade.php :");
        $this->newLine();
        $this->line("   1. Juste avant @endsection (fin du fichier) :");
        $this->line("      <x-formateur-modal />");
        $this->line("      OU");
        $this->line("      @include('admin.formateurs.partials.modal-create')");
        $this->newLine();
        $this->line("   2. Dans @push('scripts') ou avant </body> :");
        $this->line("      <script>");
        $this->line("        function openFormateurModal() {");
        $this->line("          document.getElementById('modalCreateFormateur').classList.remove('hidden');");
        $this->line("        }");
        $this->line("      </script>");

        return self::SUCCESS;
    }

