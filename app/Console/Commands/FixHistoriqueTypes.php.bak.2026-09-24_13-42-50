<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixHistoriqueTypes extends Command
{
    protected $signature = 'fix:historique-types';
    protected $description = 'Corrige les valeurs "type" pour respecter la contrainte CHECK';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔧 CORRECTION DES TYPES D\'HISTORIQUE                   ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('📌 Valeurs autorisées : affectation, session, etablissement, filiere, statut');
        $this->line('');

        $path = app_path('Http/Controllers/Admin/FormateurController.php');

        if (!File::exists($path)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        // Backup
        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $this->line('💾 Backup créé');

        $content = File::get($path);
        $original = $content;

        // ═══════════════════════════════════════════════
        // Remplacements : 'creation' → 'statut' (par défaut)
        //                 'modification' → 'statut'
        //                 'suppression' → 'statut'
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Remplacement des valeurs interdites');

        $replacements = [
            "'type'         => 'creation'"     => "'type'         => 'statut'",
            "'type'         => 'modification'" => "'type'         => 'statut'",
            "'type'         => 'suppression'"  => "'type'         => 'statut'",
            // Variantes avec espacement différent
            "'type' => 'creation'"     => "'type'         => 'statut'",
            "'type' => 'modification'" => "'type'         => 'statut'",
            "'type' => 'suppression'"  => "'type'         => 'statut'",
        ];

        $count = 0;
        foreach ($replacements as $search => $replace) {
            if (str_contains($content, $search)) {
                $content = str_replace($search, $replace, $content);
                $this->info("   ✅ '{$search}' → '{$replace}'");
                $count++;
            }
        }

        // Regex plus souple pour attraper toutes les variantes
        $content = preg_replace(
            "/'type'\s*=>\s*'(?:creation|modification|suppression|create|update|delete)'/",
            "'type'         => 'statut'",
            $content
        );

        if ($count === 0 && $content === $original) {
            // Essayer la regex
            $content = preg_replace(
                "/'type'\s*=>\s*'(?:creation|modification|suppression)'/",
                "'type'         => 'statut'",
                $content
            );
            if ($content !== $original) {
                $this->info('   ✅ Remplacements effectués via regex');
            } else {
                $this->warn('   ⚠️  Aucun remplacement — vérifiez le code manuellement');
            }
        }

        // ═══════════════════════════════════════════════
        // Ajouter try/catch par sécurité
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Ajout de try/catch (sécurité anti-crash)');

        // Envelopper les HistoriqueFormateurModel::create dans try/catch
        $content = preg_replace_callback(
            '/(\s+)(HistoriqueFormateurModel::create\(\s*\[.*?\]\s*\)\s*;)/s',
            function ($m) {
                return $m[1] . "try {\n"
                    . "                " . trim($m[2]) . "\n"
                    . "            } catch (\\Throwable \$e) {\n"
                    . "                \\Log::warning('Historique non enregistré : ' . \$e->getMessage());\n"
                    . "            }";
            },
            $content
        );

        // ═══════════════════════════════════════════════
        // Enregistrer
        // ═══════════════════════════════════════════════
        if ($content === $original) {
            $this->line('');
            $this->warn('⚠️  Aucune modification appliquée');
        } else {
            File::put($path, $content);
            $this->line('');
            $this->info('💾 Fichier enregistré');
        }

        // ═══════════════════════════════════════════════
        // Vérifier syntaxe PHP
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Vérification syntaxe PHP');

        $output = [];
        $returnCode = 0;
        exec('php -l "' . $path . '" 2>&1', $output, $returnCode);

        if ($returnCode === 0) {
            $this->info('   ✅ Syntaxe PHP valide');
        } else {
            $this->error('   ❌ ERREUR SYNTAXE :');
            foreach ($output as $o) {
                $this->line('      ' . $o);
            }
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // Vider les caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Vidage des caches');
        $this->call('optimize:clear');
        $this->call('view:clear');
        $this->call('config:clear');
        $this->info('   ✅ Caches vidés');

        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 TERMINÉ                                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/formateurs');
        $this->line('   • Cliquez "Ajouter un formateur"');
        $this->line('   • Remplissez les champs');
        $this->line('   • Enregistrez → doit rediriger vers la liste ✅');

        return self::SUCCESS;
    }
}