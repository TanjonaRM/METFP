<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class AddNotificationsFormateurSidebar extends Command
{
    protected $signature = 'project:add-notifications-formateur-sidebar
                            {--backup : Sauvegarder les fichiers existants (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Ajoute l\'entrée "Notifications" dans la sidebar + la route + le contrôleur';

    public function handle(): int
    {
        $this->info("➕ Ajout de Notifications dans la sidebar formateur");
        $this->newLine();

        if (!$this->option('force') && !$this->confirm('Ajouter Notifications (sidebar + route + contrôleur + vue) ?', true)) {
            $this->warn('Annulé.');
            return self::FAILURE;
        }

        // ============================================================
        // 1. Modifier la sidebar
        // ============================================================
        $sidebarPath = base_path('resources/views/layouts/formateur.blade.php');

        if (!File::exists($sidebarPath)) {
            $this->error("❌ Sidebar introuvable");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            File::copy($sidebarPath, $sidebarPath . '.bak.' . date('Y-m-d_H-i-s'));
            $this->line("  💾 Backup : formateur.blade.php");
        }

        $sidebarContent = File::get($sidebarPath);

        // Vérifier si déjà présent
        if (str_contains($sidebarContent, "formateur.notifications.index")) {
            $this->warn("  ⚠️  Notifications déjà présente dans la sidebar");
        } else {
            // Insérer après "Demande sessions"
            $pattern = "/(\s*\[\s*'route'\s*=>\s*'formateur\.sessions\.\*',\s*\n\s*'url'\s*=>\s*'formateur\.sessions\.index',\s*\n\s*'icon'\s*=>\s*'event',\s*\n\s*'label'\s*=>\s*'[^']*',\s*\n\s*\],\s*\n)/";

            $replacement = '$1' . <<<'PHP'
                [
                    'route' => 'formateur.notifications.*',
                    'url'   => 'formateur.notifications.index',
                    'icon'  => 'notifications',
                    'label' => 'Notifications',
                ],

PHP;

            if (preg_match($pattern, $sidebarContent)) {
                $sidebarContent = preg_replace($pattern, $replacement, $sidebarContent);
                File::put($sidebarPath, $sidebarContent);
                $this->line("  ✅ Sidebar : entrée 'Notifications' ajoutée");
            } else {
                $this->error("  ❌ Impossible de trouver le point d'insertion dans la sidebar");
                return self::FAILURE;
            }
        }

        // ============================================================
        // 2. Ajouter la route
        // ============================================================
        $routePath = base_path('routes/formateur.php');

        if (File::exists($routePath)) {
            if ($this->option('backup')) {
                File::copy($routePath, $routePath . '.bak.' . date('Y-m-d_H-i-s'));
                $this->line("  💾 Backup : routes/formateur.php");
            }

            $routeContent = File::get($routePath);

            if (!str_contains($routeContent, "formateur.notifications")) {
                // Ajouter le use
                if (!str_contains($routeContent, 'NotificationController')) {
                    $routeContent = str_replace(
                        "use App\Http\Controllers\Formateur\ProfileController;",
                        "use App\Http\Controllers\Formateur\ProfileController;\nuse App\Http\Controllers\Formateur\NotificationController;",
                        $routeContent
                    );
                }

                // Ajouter les routes notifications après le groupe sessions
                $routeBlock = <<<'PHP'

        // ============================================================
        // NOTIFICATIONS
        // ============================================================
        Route::prefix('notifications')->name('notifications.')->group(function () {
            Route::get('/', [NotificationController::class, 'index'])->name('index');
            Route::post('/{id}/read', [NotificationController::class, 'markAsRead'])->name('mark-read');
            Route::post('/read-all', [NotificationController::class, 'markAllAsRead'])->name('read-all');
            Route::delete('/{id}', [NotificationController::class, 'destroy'])->name('destroy');
        });
PHP;

                // Insérer après le groupe sessions
                $sessionEndPattern = "/(\}\s*\);\s*\n\s*\/\/\s*=+\s*\n\s*\/\/\s*PROFIL)/";
                if (preg_match($sessionEndPattern, $routeContent)) {
                    $routeContent = preg_replace($sessionEndPattern, $routeBlock . "\n$1", $routeContent);
                } else {
                    // Fallback : insérer avant "// PROFIL"
                    $routeContent = str_replace(
                        "        // ============================================================\n        // PROFIL",
                        $routeBlock . "\n        // ============================================================\n        // PROFIL",
                        $routeContent
                    );
                }

                File::put($routePath, $routeContent);
                $this->line("  ✅ routes/formateur.php : routes notifications ajoutées");
            } else {
                $this->warn("  ⚠️  Routes notifications déjà présentes");
            }
        }

        // ============================================================
        // 3. Créer le NotificationController
        // ============================================================
        $controllerPath = base_path('app/Http/Controllers/Formateur/NotificationController.php');

        if (!File::exists(dirname($controllerPath))) {
            File::makeDirectory(dirname($controllerPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($controllerPath)) {
            File::copy($controllerPath, $controllerPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($controllerPath, $this->getController());
        $this->line("  ✅ NotificationController créé");

        // ============================================================
        // 4. Créer la vue
        // ============================================================
        $viewPath = base_path('resources/views/formateur/notifications/index.blade.php');

        if (!File::exists(dirname($viewPath))) {
            File::makeDirectory(dirname($viewPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($viewPath)) {
            File::copy($viewPath, $viewPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($viewPath, $this->getView());
        $this->line("  ✅ Vue notifications créée");

        // ============================================================
        // 5. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');
        $this->call('route:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : Notifications ajoutées");
        $this->line("  • Sidebar : entrée ajoutée");
        $this->line("  • Route : /formateur/notifications");
        $this->line("  • Contrôleur : NotificationController");
        $this->line("  • Vue : formateur/notifications/index.blade.php");

        return self::SUCCESS;
    }

    // ============================================================
    // CONTROLLER
    // ============================================================
    protected function getController(): string
    {
        return <<<'PHP'
<?php

namespace App\Http\Controllers\Formateur;

use App\Http\Controllers\Controller;
use App\Models\Notification;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;

class NotificationController extends Controller
{
    /**
     * Liste des notifications du formateur connecté
     */
    public function index(Request $request)
    {
        $user = Auth::guard('formateur')->user();

        $query = Notification::query()
            ->where('user_id', $user->id)
            ->orWhereNull('user_id')  // notifications globales
            ->latest();

        if ($request->filled('statut')) {
            if ($request->statut === 'non_lues') {
                $query->where('lu', false);
            } elseif ($request->statut === 'lues') {
                $query->where('lu', true);
            }
        }

        if ($request->filled('type')) {
            $query->where('type', $request->type);
        }

        if ($request->filled('search')) {
            $s = $request->search;
            $query->where(function ($q) use ($s) {
                $q->where('titre', 'like', "%{$s}%")
                  ->orWhere('message', 'like', "%{$s}%");
            });
        }

        $notifications = $query->paginate(20)->withQueryString();

        $stats = [
            'total'    => Notification::where('user_id', $user->id)
                ->orWhereNull('user_id')->count(),
            'non_lues' => Notification::where('user_id', $user->id)
                ->orWhereNull('user_id')
                ->where('lu', false)->count(),
            'lues'     => Notification::where('user_id', $user->id)
                ->orWhereNull('user_id')
                ->where('lu', true)->count(),
        ];

        return view('formateur.notifications.index', compact('notifications', 'stats'));
    }

    /**
     * Marquer une notification comme lue
     */
    public function markAsRead(int $id)
    {
        $notification = Notification::findOrFail($id);
        $notification->update(['lu' => true]);

        if (request()->ajax() || request()->wantsJson()) {
            return response()->json(['success' => true]);
        }

        return back()->with('success', 'Notification marquée comme lue.');
    }

    /**
     * Tout marquer comme lu
     */
    public function markAllAsRead()
    {
        $user = Auth::guard('formateur')->user();

        Notification::where(function ($q) use ($user) {
                $q->where('user_id', $user->id)
                  ->orWhereNull('user_id');
            })
            ->where('lu', false)
            ->update(['lu' => true]);

        if (request()->ajax() || request()->wantsJson()) {
            return response()->json(['success' => true]);
        }

        return back()->with('success', 'Toutes les notifications sont marquées comme lues.');
    }

    /**
     * Supprimer une notification
     */
    public function destroy(int $id)
    {
        Notification::findOrFail($id)->delete();

        if (request()->ajax() || request()->wantsJson()) {
            return response()->json(['success' => true]);
        }

        return back()->with('success', 'Notification supprimée.');
    }
}
PHP;
    }

