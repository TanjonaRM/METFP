<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixAdminSidebarRetract extends Command
{
    protected $signature = 'project:fix-admin-sidebar-retract
                            {--backup : Sauvegarder le fichier (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Corrige la sidebar admin rétractable (JS + CSS)';

    public function handle(): int
    {
        $this->info("🔧 Correction de la sidebar admin rétractable");
        $this->newLine();

        $path = 'resources/views/layouts/admin.blade.php';
        $fullPath = base_path($path);

        if (!File::exists($fullPath)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
            File::copy($fullPath, $backupPath);
            $this->line("  💾 Backup : " . basename($backupPath));
        }

        File::put($fullPath, $this->getLayout());
        $size = round(strlen($this->getLayout()) / 1024, 2);
        $this->line("  ✅ {$path} réécrit ({$size} Ko)");

        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : sidebar admin rétractable");
        $this->line("  • Largeur rétractée : 72px");
        $this->line("  • Largeur étendue  : 300px");
        $this->line("  • Bouton verrouillage : 3 états");
        $this->line("  • Tooltips sur icônes");
        $this->line("  • Modal notifications : conservée");

        return self::SUCCESS;
    }

