<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class CheckEtablissementNomUnique extends Command
{
    protected $signature = 'fix:etablissement-nom-unique';
    protected $description = 'Vérifie que le nom d\'établissement est unique';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔧 VÉRIFICATION NOM ÉTABLISSEMENT UNIQUE                ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');

        // ═══════════════════════════════════════════════
        // 1. Backup du controller
        // ═══════════════════════════════════════════════
        $path = app_path('Http/Controllers/Admin/EtablissementController.php');

        if (!File::exists($path)) {
            $this->error("❌ Fichier introuvable");
            return self::FAILURE;
        }

        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $this->line('💾 Backup créé');

        $content = File::get($path);

        // ═══════════════════════════════════════════════
        // 2. Remplacer la méthode store()
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Remplacement de store()');

        $newStore = <<<'PHP'
    public function store(Request $request)
    {
        // ⚡ Vérifier si un établissement avec le même NOM existe déjà
        $nomExistant = \Infrastructure\Persistence\Eloquent\Models\EtablissementModel::where('nom', $request->nom)->first();

        if ($nomExistant) {
            return back()
                ->withInput()
                ->withErrors([
                    'nom' => "Cet établissement existe déjà : \"{$nomExistant->nom}\" (code : {$nomExistant->code})",
                ]);
        }

        $validated = $request->validate([
            'code'                => 'nullable|string|unique:etablissements,code',
            'nom'                 => 'required|string|max:150',
            'type'                => 'required|in:CFP,LTP,Lycee,Autre',
            'region'              => 'nullable|string|max:100',
            'adresse'             => 'nullable|string|max:255',
            'contact_responsable' => 'nullable|string|max:150',
            'email'               => 'nullable|email|max:150',
            'statut'              => 'required|in:actif,inactif,suspendu',
        ]);

        // ⚡ Auto-génération du code : TYPE-PREMIER-MOT
        if (empty($validated['code'])) {
            $type = strtoupper(trim($validated['type'] ?? 'ETB'));
            $nom  = trim($validated['nom'] ?? '');

            // Retirer le type du début du nom si présent
            $nom = preg_replace('/^' . preg_quote($type, '/') . '\s+/i', '', $nom);

            // Prendre le premier mot
            $parts = preg_split('/[\s\-]+/', $nom);
            $mot   = strtoupper($parts[0] ?? 'X');

            $validated['code'] = $type . '-' . $mot;
        }

        $etablissement = \Infrastructure\Persistence\Eloquent\Models\EtablissementModel::create($validated);

        // Notification
        try {
            if (class_exists(\App\Services\NotificationService::class)) {
                \App\Services\NotificationService::etablissementCree($etablissement);
            }
        } catch (\Throwable $e) {
            \Log::warning('Notification échouée : ' . $e->getMessage());
        }

        return redirect()
            ->route('admin.etablissements.index')
            ->with('success', 'Établissement créé avec succès.');
    }
PHP;

        // Remplacer la méthode store() existante
        $pattern = '/public function store\s*\([^)]*\)\s*\{.*?\n    \}/s';

        if (preg_match($pattern, $content)) {
            $content = preg_replace($pattern, $newStore, $content, 1);
            $this->info('   ✅ Méthode store() remplacée');
        } else {
            $this->error('   ❌ Pattern store() introuvable');
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // 3. Sauvegarder
        // ═══════════════════════════════════════════════
        File::put($path, $content);

        // ═══════════════════════════════════════════════
        // 4. Vérifier syntaxe
        // ═══════════════════════════════════════════════
        $output = [];
        $returnCode = 0;
        exec('php -l "' . $path . '" 2>&1', $output, $returnCode);

        if ($returnCode === 0) {
            $this->info('   ✅ Syntaxe valide');
        } else {
            $this->error('   ❌ Erreur syntaxe :');
            foreach ($output as $o) $this->line('      ' . $o);
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // 5. Vérifier la méthode NotificationService
        // ═══════════════════════════════════════════════
        $servicePath = app_path('Services/NotificationService.php');
        if (File::exists($servicePath)) {
            $svc = File::get($servicePath);
            if (!str_contains($svc, 'function etablissementCree')) {
                $this->warn('   ⚠️  NotificationService::etablissementCree() manquante');
                $this->line('   👉 Lancez : php artisan add:etablissement-notification');
            }
        }

        // ═══════════════════════════════════════════════
        // 6. Vider caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Vidage des caches');
        $this->call('optimize:clear');
        $this->call('view:clear');
        $this->info('   ✅ Caches vidés');

        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 TERMINÉ                                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Comportement :');
        $this->line('   • Si le NOM existe déjà → message "Cet établissement existe déjà"');
        $this->line('   • Sinon → création + code auto-généré');

        return self::SUCCESS;
    }
}