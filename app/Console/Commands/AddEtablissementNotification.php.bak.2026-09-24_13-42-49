<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class AddEtablissementNotification extends Command
{
    protected $signature = 'add:etablissement-notification
                            {--remove : Retirer l\'appel au lieu de créer la méthode}';

    protected $description = 'Ajoute la méthode etablissementCree() dans NotificationService';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎯 NOTIFICATION ÉTABLISSEMENT                           ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');

        if ($this->option('remove')) {
            return $this->removeCall();
        }

        return $this->addMethod();
    }

    // ═══════════════════════════════════════════════════════
    // SOLUTION A : Retirer l'appel
    // ═══════════════════════════════════════════════════════
    private function removeCall(): int
    {
        $this->line('▶ Mode --remove : retirer l\'appel dans EtablissementController');

        $ctrlPath = app_path('Http/Controllers/Admin/EtablissementController.php');

        if (!File::exists($ctrlPath)) {
            $this->error('❌ Controller introuvable');
            return self::FAILURE;
        }

        File::copy($ctrlPath, $ctrlPath . '.bak.' . date('Y-m-d_His'));
        $this->line('💾 Backup créé');

        $content = File::get($ctrlPath);

        // Retirer le bloc d'appel
        $patterns = [
            '/\s*if\s*\(class_exists[^{]*NotificationService[^{]*\{[^}]*etablissementCree[^}]*\}\s*/s',
            '/\s*\\\\?App\\\\Services\\\\NotificationService::etablissementCree\([^;]*\);\s*/s',
            '/\s*NotificationService::etablissementCree\([^;]*\);\s*/s',
        ];

        $removed = false;
        foreach ($patterns as $pattern) {
            if (preg_match($pattern, $content)) {
                $content = preg_replace($pattern, '', $content);
                $removed = true;
                $this->info('   ✅ Appel retiré');
                break;
            }
        }

        if (!$removed) {
            $this->warn('   ⚠️  Aucun appel trouvé');
        }

        File::put($ctrlPath, $content);

        $this->call('optimize:clear');
        $this->call('view:clear');
        $this->info('   ✅ Caches vidés');

        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/etablissements');

        return self::SUCCESS;
    }

    // ═══════════════════════════════════════════════════════
    // SOLUTION B : Créer la méthode etablissementCree()
    // ═══════════════════════════════════════════════════════
    private function addMethod(): int
    {
        $this->line('▶ Ajout de la méthode etablissementCree()');

        $servicePath = app_path('Services/NotificationService.php');

        if (!File::exists($servicePath)) {
            $this->error('❌ NotificationService introuvable');
            return self::FAILURE;
        }

        $content = File::get($servicePath);

        // Vérifier si la méthode existe déjà
        if (str_contains($content, 'function etablissementCree')) {
            $this->warn('⏭️  Méthode etablissementCree() existe déjà');
            return self::SUCCESS;
        }

        // Backup
        File::copy($servicePath, $servicePath . '.bak.' . date('Y-m-d_His'));
        $this->line('💾 Backup créé');

        // Ajouter l'import EtablissementModel si absent
        if (!str_contains($content, 'use Infrastructure\Persistence\Eloquent\Models\EtablissementModel;')) {
            $content = str_replace(
                "use Infrastructure\Persistence\Eloquent\Models\DemandeSessionModel;",
                "use Infrastructure\Persistence\Eloquent\Models\DemandeSessionModel;\nuse Infrastructure\Persistence\Eloquent\Models\EtablissementModel;",
                $content
            );
            $this->info('   ✅ Import EtablissementModel ajouté');
        }

        // Créer la nouvelle méthode
        $newMethod = <<<'PHP'

    /**
     * Nouvel établissement créé
     */
    public static function etablissementCree(EtablissementModel $etablissement): void
    {
        Notification::create([
            'user_id' => null,
            'titre'   => '🏢 Nouvel établissement créé',
            'message' => 'L\'établissement "' . $etablissement->nom . '" ('
                . ($etablissement->code ?? '') . ') a été ajouté au réseau.',
            'type'    => 'success',
            'icone'   => 'apartment',
            'lu'      => false,
            'lien'    => '/admin/etablissements/' . $etablissement->id,
            'data'    => json_encode([
                'etablissement_id' => $etablissement->id,
                'type'             => 'etablissement_cree',
            ]),
        ]);
    }
PHP;

        // Insérer avant la dernière } de la classe
        $pos = strrpos($content, '}');
        if ($pos !== false) {
            $content = substr($content, 0, $pos) . $newMethod . "\n}\n";
            File::put($servicePath, $content);
            $this->info('   ✅ Méthode etablissementCree() ajoutée');
        } else {
            $this->error('   ❌ Impossible d\'insérer la méthode');
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // Adapter l'appel dans le controller
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Adaptation de l\'appel dans EtablissementController');

        $ctrlPath = app_path('Http/Controllers/Admin/EtablissementController.php');
        if (File::exists($ctrlPath)) {
            File::copy($ctrlPath, $ctrlPath . '.bak.' . date('Y-m-d_His'));
            $ctrlContent = File::get($ctrlPath);

            // Nouveau bloc d'appel
            $newCall = <<<'PHP'
try {
            \App\Services\NotificationService::etablissementCree($etablissement);
        } catch (\Throwable $e) {
            \Log::warning('Notification échouée : ' . $e->getMessage());
        }
PHP;

            // Chercher l'ancien appel et le remplacer
            $patterns = [
                '/\s*if\s*\(class_exists[^{]*NotificationService[^{]*\{[^}]*etablissementCree\([^)]*\);[^}]*\}\s*/s',
                '/\s*if\s*\(class_exists[^{]*NotificationService[^{]*\{[^}]*\}\s*/s',
                '/\s*\\\\?App\\\\Services\\\\NotificationService::etablissementCree\([^;]*\);\s*/s',
                '/\s*NotificationService::etablissementCree\([^;]*\);\s*/s',
            ];

            $replaced = false;
            foreach ($patterns as $pattern) {
                if (preg_match($pattern, $ctrlContent)) {
                    $ctrlContent = preg_replace($pattern, "\n        " . $newCall . "\n", $ctrlContent);
                    $replaced = true;
                    break;
                }
            }

            if ($replaced) {
                File::put($ctrlPath, $ctrlContent);
                $this->info('   ✅ Appel adapté');

                // Vérifier syntaxe
                $output = [];
                $rc = 0;
                exec('php -l "' . $ctrlPath . '" 2>&1', $output, $rc);
                if ($rc === 0) {
                    $this->info('   ✅ Syntaxe valide');
                } else {
                    $this->error('   ❌ Erreur syntaxe');
                    foreach ($output as $o) $this->line('      ' . $o);
                }
            } else {
                $this->warn('   ⚠️  Appel à adapter manuellement');
            }
        }

        // ═══════════════════════════════════════════════
        // Vider les caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Vidage des caches');
        $this->call('optimize:clear');
        $this->call('view:clear');
        $this->info('   ✅ Caches vidés');

        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 TERMINÉ                                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/etablissements');
        $this->line('   Créez un établissement');
        $this->line('   → Une notification doit apparaître (icône 🔔 en haut)');

        return self::SUCCESS;
    }
}