<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class AddNotificationsRoutes extends Command
{
    protected $signature = 'project:add-notifications-routes
                            {--backup : Sauvegarder le fichier existant (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Ajoute les routes notifications dans routes/formateur.php';

    public function handle(): int
    {
        $this->info("🔧 Ajout des routes Notifications formateur");
        $this->newLine();

        $path = 'routes/formateur.php';
        $fullPath = base_path($path);

        if (!File::exists($fullPath)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            File::copy($fullPath, $fullPath . '.bak.' . date('Y-m-d_H-i-s'));
            $this->line("  💾 Backup : routes/formateur.php");
        }

        // ============================================================
        // Réécrire complètement le fichier avec les notifications
        // ============================================================
        $content = $this->getRoutes();
        File::put($fullPath, $content);

        $size = round(strlen($content) / 1024, 2);
        $this->line("  ✅ routes/formateur.php réécrit ({$size} Ko)");

        // ============================================================
        // Vérifier que le NotificationController existe
        // ============================================================
        $controllerPath = base_path('app/Http/Controllers/Formateur/NotificationController.php');

        if (!File::exists($controllerPath)) {
            $this->warn("  ⚠️  NotificationController introuvable");
            $this->line("     → Création automatique...");

            File::put($controllerPath, $this->getController());
            $this->line("  ✅ NotificationController créé");
        } else {
            $this->line("  ✅ NotificationController existe déjà");
        }

        // ============================================================
        // Vérifier que la vue existe
        // ============================================================
        $viewPath = base_path('resources/views/formateur/notifications/index.blade.php');

        if (!File::exists($viewPath)) {
            File::makeDirectory(dirname($viewPath), 0755, true);
            File::put($viewPath, $this->getView());
            $this->line("  ✅ Vue notifications créée");
        } else {
            $this->line("  ✅ Vue notifications existe déjà");
        }

        // ============================================================
        // Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('route:clear');
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS");
        $this->line("  • 4 routes notifications ajoutées");
        $this->line("  • Testez : http://localhost:8000/formateur/notifications");

        return self::SUCCESS;
    }

