<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class InstallDemandeAffectations extends Command
{
    protected $signature = 'project:install-demande-affectations
                            {--backup : Sauvegarder les fichiers existants (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Installe le module Demande d\'affectations (modal + notifications admin)';

    public function handle(): int
    {
        $this->info("📋 Installation du module Demande d'affectations");
        $this->newLine();

        if (!$this->option('force') && !$this->confirm('Créer le module complet ?', true)) {
            $this->warn('Annulé.');
            return self::FAILURE;
        }

        // ============================================================
        // 1. Migration
        // ============================================================
        $migrationName = date('Y_m_d_His') . '_create_demande_affectations_table.php';
        $migrationPath = base_path('database/migrations/' . $migrationName);

        File::put($migrationPath, $this->getMigration());
        $this->line("  ✅ Migration créée : {$migrationName}");

        // ============================================================
        // 2. Modèle
        // ============================================================
        $modelPath = base_path('app/Infrastructure/Persistence/Eloquent/Models/DemandeAffectationModel.php');

        if (!File::exists(dirname($modelPath))) {
            File::makeDirectory(dirname($modelPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($modelPath)) {
            File::copy($modelPath, $modelPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($modelPath, $this->getModel());
        $this->line("  ✅ DemandeAffectationModel créé");

        // ============================================================
        // 3. Contrôleur
        // ============================================================
        $controllerPath = base_path('app/Http/Controllers/Formateur/DemandeAffectationController.php');

        if (!File::exists(dirname($controllerPath))) {
            File::makeDirectory(dirname($controllerPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($controllerPath)) {
            File::copy($controllerPath, $controllerPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($controllerPath, $this->getController());
        $this->line("  ✅ DemandeAffectationController créé");

        // ============================================================
        // 4. Vue index
        // ============================================================
        $viewPath = base_path('resources/views/formateur/demandes/index.blade.php');

        if (!File::exists(dirname($viewPath))) {
            File::makeDirectory(dirname($viewPath), 0755, true);
        }

        File::put($viewPath, $this->getView());
        $this->line("  ✅ Vue demandes/index créée");

        // ============================================================
        // 5. Modifier routes/formateur.php
        // ============================================================
        $routesPath = base_path('routes/formateur.php');

        if (File::exists($routesPath)) {
            if ($this->option('backup')) {
                File::copy($routesPath, $routesPath . '.bak.' . date('Y-m-d_H-i-s'));
            }

            File::put($routesPath, $this->getRoutes());
            $this->line("  ✅ routes/formateur.php mis à jour");
        }

        // ============================================================
        // 6. Modifier la sidebar (ajouter "Demande affectations")
        // ============================================================
        $sidebarPath = base_path('resources/views/layouts/formateur.blade.php');

        if (File::exists($sidebarPath)) {
            if ($this->option('backup')) {
                File::copy($sidebarPath, $sidebarPath . '.bak.' . date('Y-m-d_H-i-s'));
            }

            $sidebarContent = File::get($sidebarPath);

            // Remplacer "Demande affectations" par le nouveau lien
            if (str_contains($sidebarContent, "formateur.affectations.index")) {
                $sidebarContent = str_replace(
                    "'url'   => 'formateur.affectations.index',",
                    "'url'   => 'formateur.demandes.index',",
                    $sidebarContent
                );
                $sidebarContent = str_replace(
                    "'route' => 'formateur.affectations.*',",
                    "'route' => 'formateur.demandes.*',",
                    $sidebarContent
                );
                File::put($sidebarPath, $sidebarContent);
                $this->line("  ✅ Sidebar mise à jour");
            }
        }

        // ============================================================
        // 7. Migrer la base de données
        // ============================================================
        $this->newLine();
        $this->info("🗄️  Migration de la base de données...");
        $this->call('migrate', ['--force' => true]);

        // ============================================================
        // 8. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('route:clear');
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : Module Demande d'affectations installé");
        $this->line("  • Table : demande_affectations");
        $this->line("  • Page : /formateur/demandes");
        $this->line("  • Notifications envoyées à l'admin");

        return self::SUCCESS;
    }

