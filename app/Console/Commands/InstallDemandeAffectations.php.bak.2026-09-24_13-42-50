                <button type="button" onclick="closeDemandeModal()" class="btn-secondary">
                    Annuler
                </button>
                <button type="submit" class="btn-primary">
                    <span class="material-symbols-rounded text-lg">send</span>
                    Envoyer la demande
                </button>
            </div>
        </form>
    </div>
</div>

{{-- ============================================================
     MODAL : DÉTAIL DEMANDE
     ============================================================ --}}
<div id="showModal" class="fixed inset-0 z-[9999] items-center justify-center p-4" style="display:none;">
    <div class="absolute inset-0 bg-black/50" onclick="closeShowModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] flex flex-col">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
            <h2 class="font-display text-lg font-bold text-slate-900">Détail de la demande</h2>
            <button type="button" onclick="closeShowModal()"
                    class="w-9 h-9 rounded-md flex items-center justify-center text-slate-500 hover:bg-slate-100">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <div id="showContent" class="px-6 py-5 overflow-y-auto">
            <div class="text-center py-8 text-slate-400">Chargement...</div>
        </div>
    </div>
</div>

<script>
    function openDemandeModal() {
        document.getElementById('demandeModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
    function closeDemandeModal() {
        document.getElementById('demandeModal').style.display = 'none';
        document.body.style.overflow = '';
    }

    function openShowModal(id) {
        document.getElementById('showModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';

        fetch(`/formateur/demandes/${id}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        })
        .then(r => r.json())
        .then(data => {
            document.getElementById('showContent').innerHTML = data.html;
        })
        .catch(err => {
            document.getElementById('showContent').innerHTML =
                '<div class="text-center py-8 text-red-500">Erreur</div>';
        });
    }
    function closeShowModal() {
        document.getElementById('showModal').style.display = 'none';
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            closeDemandeModal();
            closeShowModal();
        }
    });
</script>

@endsection
