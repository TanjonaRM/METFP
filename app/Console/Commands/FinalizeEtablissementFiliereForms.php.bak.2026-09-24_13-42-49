    // ═══════════════════════════════════════════════════════
    // 2. CONTROLLER — Auto-génération du code
    // ═══════════════════════════════════════════════════════
    private function updateEtablissementController(): void
    {
        $this->line('');
        $this->line('▶ 2/4 — Controller Etablissement');

        $path = app_path('Http/Controllers/Admin/EtablissementController.php');
        if (!File::exists($path)) {
            $this->error("   ❌ Introuvable");
            return;
        }

        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $content = File::get($path);

        // Vérifier si déjà modifié
        if (str_contains($content, 'generateCode') || str_contains($content, "strtoupper(substr")) {
            $this->warn('   ⏭️  Déjà modifié');
            return;
        }

        // Trouver la méthode store()
        $pattern = '/(public function store\s*\([^)]*\)\s*\{)(.*?)(\n    \})/s';

        if (preg_match($pattern, $content, $m)) {
            $body = $m[2];

            // Injecter la génération du code AVANT le create
            $insertCode = <<<'PHP'

        // ⚡ Auto-génération du code : TYPE-PREMIER-MOT
        if (empty($data['code'])) {
            $type = strtoupper(trim($data['type'] ?? 'ETB'));
            // Retirer le type du début du nom si présent
            $nom = trim($data['nom'] ?? '');
            $nom = preg_replace('/^' . preg_quote($type, '/') . '\s+/i', '', $nom);
            // Prendre le premier mot
            $parts = preg_split('/[\s\-]+/', $nom);
            $mot = strtoupper($parts[0] ?? 'X');
            $data['code'] = $type . '-' . $mot;
        }

PHP;

            // Chercher FormateurModel::create ou EtablissementModel::create
            if (preg_match('/(\$etablissement\s*=\s*EtablissementModel::create\()/s', $body)) {
                $body = preg_replace(
                    '/(\$etablissement\s*=\s*EtablissementModel::create\()/s',
                    $insertCode . '$1',
                    $body
                );
            } elseif (preg_match('/(EtablissementModel::create\()/s', $body)) {
                $body = preg_replace(
                    '/(EtablissementModel::create\()/s',
                    $insertCode . '$1',
                    $body
                );
            }

            $content = $m[1] . $body . $m[3];
            File::put($path, $content);
            $this->info('   ✅ Auto-génération du code injectée dans store()');
        } else {
            $this->warn('   ⚠️  Méthode store() introuvable');
        }
    }

    // ═══════════════════════════════════════════════════════
    // 3. FORM REQUEST — Retirer code obligatoire
    // ═══════════════════════════════════════════════════════
    private function updateEtablissementRequest(): void
    {
        $this->line('');
        $this->line('▶ 3/4 — Form Request Etablissement');

        $paths = [
            app_path('Http/Requests/Etablissement/StoreEtablissementRequest.php'),
            app_path('Http/Requests/Etablissement/UpdateEtablissementRequest.php'),
        ];

        foreach ($paths as $path) {
            if (!File::exists($path)) {
                $this->warn("   ⏭️  " . basename($path) . " introuvable");
                continue;
            }

            File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
            $content = File::get($path);

            // Rendre le code 'nullable'
            $content = preg_replace(
                "/'code'\s*=>\s*\[[^\]]*\]/",
                "'code'      => ['nullable', 'string', 'max:50'],",
                $content
            );

            File::put($path, $content);
            $this->info('   ✅ ' . basename($path) . ' : code rendu nullable');
        }
    }

    // ═══════════════════════════════════════════════════════
    // 4. FORMULAIRE FILIÈRE — Retirer description
    // ═══════════════════════════════════════════════════════
    private function updateFiliereForm(): void
    {
        $this->line('');
        $this->line('▶ 4/4 — Formulaire Filière (retirer description)');

        $paths = [
            resource_path('views/admin/filieres/partials/_form.blade.php'),
            resource_path('views/admin/filieres/partials/form.blade.php'),
        ];

        foreach ($paths as $path) {
            if (!File::exists($path)) continue;

            File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
            $content = File::get($path);

            // Retirer le bloc description (textarea)
            $patterns = [
                '/<div[^>]*>\s*<label[^>]*for="description"[^>]*>.*?<\/label>\s*<textarea[^>]*name="description"[^>]*>.*?<\/textarea>.*?<\/div>/s',
                '/<div[^>]*>\s*<label[^>]*>.*?Description.*?<\/label>.*?<\/div>/s',
                '/<textarea[^>]*name="description"[^>]*>.*?<\/textarea>/s',
            ];

            $removed = false;
            foreach ($patterns as $pattern) {
                if (preg_match($pattern, $content)) {
                    $content = preg_replace($pattern, '', $content);
                    $removed = true;
                    break;
                }
            }

            if ($removed) {
                // Nettoyer les sauts de ligne multiples
                $content = preg_replace("/\n\s*\n\s*\n/", "\n\n", $content);
                File::put($path, $content);
                $this->info('   ✅ ' . basename($path) . ' : description retirée');
            } else {
                $this->warn('   ⏭️  ' . basename($path) . ' : description déjà absente');
            }
        }
    }
