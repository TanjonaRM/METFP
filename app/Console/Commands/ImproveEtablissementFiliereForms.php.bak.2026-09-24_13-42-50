    // ═══════════════════════════════════════════════════════
    // 2. FORMULAIRE FILIÈRE (retirer description)
    // ═══════════════════════════════════════════════════════
    private function updateFiliereForm(): void
    {
        $path = resource_path('views/admin/filieres/partials/_form.blade.php');

        if (!File::exists($path)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return;
        }

        // Backup
        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $this->line('   💾 Backup créé');

        $content = File::get($path);

        // Retirer le bloc description (textarea)
        // Pattern 1 : <div>...<textarea name="description"...>...</textarea>...</div>
        $patterns = [
            // Bloc complet div + label + textarea
            '/<div[^>]*>\s*<label[^>]*for="description"[^>]*>.*?<\/label>\s*<textarea[^>]*name="description"[^>]*>.*?<\/textarea>\s*<\/div>/s',
            // Juste le div avec description
            '/<div[^>]*>\s*<label[^>]*>.*?Description.*?<\/label>.*?<\/div>/s',
            // textarea seul
            '/<textarea[^>]*name="description"[^>]*>.*?<\/textarea>/s',
        ];

        $removed = false;
        foreach ($patterns as $pattern) {
            if (preg_match($pattern, $content)) {
                $content = preg_replace($pattern, '', $content);
                $removed = true;
                break;
            }
        }

        if ($removed) {
            // Nettoyer les lignes vides multiples
            $content = preg_replace("/\n\s*\n\s*\n/", "\n\n", $content);
            File::put($path, $content);
            $this->info('   ✅ Champ description retiré');
        } else {
            $this->warn('   ⚠️  Champ description introuvable (déjà retiré ?)');
        }

        // Faire pareil pour partials/form.blade.php si existe
        $formPath = resource_path('views/admin/filieres/partials/form.blade.php');
        if (File::exists($formPath)) {
            File::copy($formPath, $formPath . '.bak.' . date('Y-m-d_His'));
            $formContent = File::get($formPath);

            foreach ($patterns as $pattern) {
                if (preg_match($pattern, $formContent)) {
                    $formContent = preg_replace($pattern, '', $formContent);
                    break;
                }
            }
            File::put($formPath, $formContent);
            $this->info('   ✅ partials/form.blade.php mis à jour');
        }
    }

    // ═══════════════════════════════════════════════════════
    // 3. VÉRIFICATION TABLE
    // ═══════════════════════════════════════════════════════
    private function checkEtablissementTable(): void
    {
        try {
            $columns = \Schema::getColumnListing('etablissements');

            $this->line('   Colonnes actuelles : ' . implode(', ', $columns));

            if (!in_array('region', $columns)) {
                $this->warn('   ⚠️  Colonne "region" manquante — créez une migration');
            } else {
                $this->info('   ✅ Colonne "region" présente');
            }

            if (!in_array('type', $columns)) {
                $this->warn('   ⚠️  Colonne "type" manquante — créez une migration');
            } else {
                $this->info('   ✅ Colonne "type" présente');
            }
        } catch (\Throwable $e) {
            $this->error('   ❌ Erreur : ' . $e->getMessage());
        }
    }
