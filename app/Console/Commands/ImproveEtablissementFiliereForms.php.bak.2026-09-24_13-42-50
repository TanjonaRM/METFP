<script>
    document.addEventListener('DOMContentLoaded', function() {
        const typeSelect = document.getElementById('type');
        const nomSelect = document.getElementById('nom');
        const codeInput = document.getElementById('code');

        function generateCode() {
            const type = typeSelect.value.trim();
            const nom = nomSelect.value.trim();

            if (type && nom) {
                // Formatter le nom : retirer les espaces, mettre en majuscules
                const nomClean = nom.toUpperCase().replace(/\s+/g, '-').replace(/[^A-Z0-9\-]/g, '');
                codeInput.value = type + '-' + nomClean;
            } else {
                codeInput.value = '';
            }
        }

        typeSelect?.addEventListener('change', generateCode);
        nomSelect?.addEventListener('change', generateCode);

        // Générer au chargement si valeurs déjà présentes (édition)
        if (typeSelect?.value && nomSelect?.value) {
            generateCode();
        }
    });
</script>
