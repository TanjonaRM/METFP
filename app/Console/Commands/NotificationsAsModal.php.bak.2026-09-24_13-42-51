<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class NotificationsAsModal extends Command
{
    protected $signature = 'project:notifications-as-modal
                            {--backup : Sauvegarder le fichier (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Transforme le dropdown de notifications en modal centrée';

    public function handle(): int
    {
        $this->info("🎯 Transformation du dropdown en modal");
        $this->newLine();

        $path = 'resources/views/layouts/admin.blade.php';
        $fullPath = base_path($path);

        if (!File::exists($fullPath)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
            File::copy($fullPath, $backupPath);
            $this->line("  💾 Backup : " . basename($backupPath));
        }

        $content = File::get($fullPath);

        // ============================================================
        // 1. Remplacer le HTML du dropdown par la modal
        // ============================================================
        // Trouver et remplacer le bloc <div id="notifications-dropdown"> ... </div>

        $dropdownPattern = '/<div id="notifications-dropdown"[\s\S]*?<\/div>\s*<\/div>\s*<\/div>/';

        $newModal = <<<'HTML'
<!-- ============================================================
     MODAL NOTIFICATIONS
     ============================================================ -->
<div id="notifications-modal"
     class="fixed inset-0 z-[99999] items-center justify-center p-4"
     style="display: none;"
     onclick="if(event.target === this) closeNotificationsModal()">

    {{-- Overlay --}}
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

    {{-- Contenu de la modal --}}
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl
                max-h-[85vh] flex flex-col overflow-hidden">

        {{-- Header modal --}}
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700
                            flex items-center justify-center shadow-sm">
                    <span class="material-symbols-rounded text-white text-xl"
                          style="font-variation-settings: 'FILL' 1;">notifications</span>
                </div>
                <div>
                    <h2 class="font-display text-lg font-bold text-slate-900">Notifications</h2>
                    <p class="text-xs text-slate-500">
                        <span id="notifications-count-label">0 non lue</span>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button onclick="markAllAsRead()"
                        class="text-[11px] font-semibold text-emerald-700 hover:text-emerald-800
                               px-3 py-1.5 rounded-lg hover:bg-emerald-50 transition">
                    Tout marquer comme lu
                </button>
                <button type="button"
                        onclick="closeNotificationsModal()"
                        class="w-9 h-9 rounded-lg flex items-center justify-center
                               text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition">
                    <span class="material-symbols-rounded text-[20px]">close</span>
                </button>
            </div>
        </div>

        {{-- Liste notifications --}}
        <div id="notifications-list" class="flex-1 overflow-y-auto">
            <div class="p-8 text-center text-slate-400 text-sm">Chargement...</div>
        </div>

        {{-- Footer modal --}}
        <div class="px-6 py-3.5 border-t border-slate-200 bg-slate-50 text-center shrink-0">
            <a href="{{ route('admin.notifications.index') }}"
               class="text-[12px] font-semibold text-emerald-700 hover:text-emerald-800
                      inline-flex items-center gap-1.5">
                Voir toutes les notifications
                <span class="material-symbols-rounded text-[14px]">arrow_forward</span>
            </a>
        </div>
    </div>
</div>
HTML;

        if (preg_match($dropdownPattern, $content)) {
            $content = preg_replace($dropdownPattern, $newModal, $content, 1);
            $this->line("  ✅ HTML du dropdown remplacé par la modal");
        } else {
            $this->warn("  ⚠️  Dropdown non trouvé avec le pattern standard");
            $this->warn("     → Vérifiez manuellement le fichier");
        }

        // ============================================================
        // 2. Remplacer le JS de toggle
        // ============================================================
        $newJS = <<<'JS'

    // ============================================
    // MODAL NOTIFICATIONS — Ouverture / Fermeture
    // ============================================
    function openNotificationsModal() {
        const modal = document.getElementById('notifications-modal');
        if (!modal) return;

        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';

        chargerNotifications();
    }

    function closeNotificationsModal() {
        const modal = document.getElementById('notifications-modal');
        if (!modal) return;

        modal.style.display = 'none';
        document.body.style.overflow = '';
    }

    // Conserver le nom "toggleNotifications" pour compatibilité avec le bouton
    function toggleNotifications() {
        openNotificationsModal();
    }

    async function chargerNotifications() {
        const list = document.getElementById('notifications-list');
        const badge = document.getElementById('notif-badge');
        const countLabel = document.getElementById('notifications-count-label');

        if (!list) return;

        try {
            const response = await fetch('{{ route("admin.notifications.recent") }}', {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });

            const contentType = response.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                const text = await response.text();
                console.error('❌ Réponse non-JSON :', text.substring(0, 300));
                list.innerHTML = '<div class="p-8 text-center text-red-400 text-sm">Endpoint invalide</div>';
                return;
            }

            const data = await response.json();

            const notifications = Array.isArray(data.notifications) ? data.notifications : [];
            const nonLues = parseInt(data.non_lues) || 0;

            // Badge
            if (badge) {
                if (nonLues > 0) {
                    badge.textContent = nonLues > 99 ? '99+' : nonLues;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            // Label compteur
            if (countLabel) {
                countLabel.textContent = nonLues > 0
                    ? nonLues + ' non lue' + (nonLues > 1 ? 's' : '')
                    : 'Aucune non lue';
            }

            // Liste vide
            if (notifications.length === 0) {
                list.innerHTML = `
                    <div class="p-12 text-center">
                        <span class="material-symbols-rounded text-5xl text-slate-300 block mb-3">notifications_off</span>
                        <p class="text-slate-500 font-semibold">Aucune notification</p>
                        <p class="text-sm text-slate-400 mt-1">Vous êtes à jour !</p>
                    </div>
                `;
                return;
            }

            // Rendu
            const icons = {
                'info':    { color: 'text-blue-600',    bg: 'bg-blue-50',    border: 'border-blue-200' },
                'success': { color: 'text-emerald-600', bg: 'bg-emerald-50', border: 'border-emerald-200' },
                'warning': { color: 'text-amber-600',   bg: 'bg-amber-50',   border: 'border-amber-200' },
                'danger':  { color: 'text-red-600',     bg: 'bg-red-50',     border: 'border-red-200' },
            };

            list.innerHTML = notifications.map(n => {
                const style = icons[n.type] || icons.info;
                const luClass = n.lu ? 'opacity-60' : '';
                const bgClass = n.lu ? '' : 'bg-emerald-50/20';
                const titre = escapeHtml(n.titre || 'Sans titre');
                const message = escapeHtml(n.message || '');
                const date = escapeHtml(n.date || '');
                const icone = escapeHtml(n.icone || 'info');
                const lien = (n.lien || '').replace(/'/g, "\\'");

                return `
                    <div class="flex items-start gap-4 px-6 py-4 border-b border-slate-100 last:border-0
                                hover:bg-slate-50 cursor-pointer transition ${luClass} ${bgClass}"
                         onclick="ouvrirNotification(${n.id}, '${lien}')">
                        <div class="w-10 h-10 rounded-lg ${style.bg} border ${style.border}
                                    flex items-center justify-center shrink-0">
                            <span class="material-symbols-rounded ${style.color} text-[20px]">${icone}</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-2">
                                <div class="font-bold text-slate-900 text-[14px]">${titre}</div>
                                <div class="text-[11px] text-slate-400 whitespace-nowrap">${date}</div>
                            </div>
                            <div class="text-[13px] text-slate-600 mt-1 leading-relaxed">${message}</div>
                        </div>
                    </div>
                `;
            }).join('');

        } catch (error) {
            console.error('❌ Erreur chargement notifications:', error);
            if (list) {
                list.innerHTML = '<div class="p-8 text-center text-red-400 text-sm">Erreur : ' + error.message + '</div>';
            }
        }
    }

    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    async function ouvrirNotification(id, lien) {
        try {
            await fetch(`/admin/notifications/${id}/read`, {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}', 'Accept': 'application/json' }
            });
            if (lien) window.location.href = lien;
            else chargerNotifications();
        } catch (error) { console.error(error); }
    }

    async function markAllAsRead() {
        try {
            await fetch('{{ route("admin.notifications.read-all") }}', {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}', 'Accept': 'application/json' }
            });
            chargerNotifications();
        } catch (error) { console.error(error); }
    }

    // Charger le badge au démarrage + polling 30s
    document.addEventListener('DOMContentLoaded', () => {
        function refreshBadge() {
            fetch('{{ route("admin.notifications.count") }}', {
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
            })
            .then(r => r.json())
            .then(data => {
                const badge = document.getElementById('notif-badge');
                const nonLues = parseInt(data.non_lues) || 0;
                if (badge) {
                    if (nonLues > 0) {
                        badge.textContent = nonLues > 99 ? '99+' : nonLues;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }
            })
            .catch(() => {});
        }

        refreshBadge();
        setInterval(refreshBadge, 30000);
    });

    // Fermer avec Échap
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeNotificationsModal();
        }
    });

JS;

        // Remplacer l'ancien bloc notifications JS
        $jsPattern = '/\/\/\s*=+\s*\n\s*\/\/\s*NOTIFICATIONS[\s\S]*?(?=\n\s*\/\/\s*=+\s*\n\s*\/\/\s*[A-Z]|\n<\/script>)/';

        if (preg_match($jsPattern, $content)) {
            $content = preg_replace($jsPattern, $newJS, $content, 1);
            $this->line("  ✅ JS notifications remplacé");
        } else {
            // Fallback : chercher "async function chargerNotifications"
            $fallbackPattern = '/async function chargerNotifications\(\)[\s\S]*?(?=\n\s*<\/script>)/';

            if (preg_match($fallbackPattern, $content)) {
                $content = preg_replace($fallbackPattern, trim($newJS), $content, 1);
                $this->line("  ✅ JS notifications remplacé (fallback)");
            } else {
                $this->error("  ❌ Impossible de trouver le JS");
                return self::FAILURE;
            }
        }

        File::put($fullPath, $content);
        $this->line("  ✅ {$path} mis à jour");

        // ============================================================
        // 3. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : dropdown transformé en modal");
        $this->line("  • Clic sur 🔔 → modal centrée");
        $this->line("  • Fermeture : clic extérieur ou Échap");
        $this->line("  • Design : carte centrée avec scroll interne");

        return self::SUCCESS;
    }
}