<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class RemoveNotificationsPageLink extends Command
{
    protected $signature = 'project:remove-notifications-page-link
                            {--backup : Sauvegarder le fichier (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Retire le lien vers la page /admin/notifications (garde uniquement la modal)';

    public function handle(): int
    {
        $this->info("🗑️  Suppression du lien vers la page notifications");
        $this->newLine();

        $path = 'resources/views/layouts/admin.blade.php';
        $fullPath = base_path($path);

        if (!File::exists($fullPath)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
            File::copy($fullPath, $backupPath);
            $this->line("  💾 Backup : " . basename($backupPath));
        }

        $content = File::get($fullPath);
        $originalSize = strlen($content);

        // ============================================================
        // 1. Supprimer le lien "Voir toutes les notifications" dans le footer
        // ============================================================
        $footerLinkPattern = '/<div class="px-6 py-3\.5 border-t border-slate-200 bg-slate-50 text-center shrink-0">[\s\S]*?<\/div>/';

        if (preg_match($footerLinkPattern, $content)) {
            $content = preg_replace($footerLinkPattern, '', $content);
            $this->line("  ✅ Footer de la modal supprimé");
        } else {
            $this->warn("  ⚠️  Footer modal non trouvé");
        }

        // ============================================================
        // 2. Supprimer le lien de navigation dans la sidebar (s'il existe)
        // ============================================================
        // Chercher un item de menu "Notifications" dans $menu
        $menuLinkPattern = "/\s*\[\s*\n\s*'route'\s*=>\s*'admin\.notifications\.\*',\s*\n\s*'url'\s*=>\s*'admin\.notifications\.index',\s*\n\s*'icon'\s*=>\s*'notifications',\s*\n\s*'label'\s*=>\s*'Notifications',\s*\n\s*\],\s*\n/s";

        if (preg_match($menuLinkPattern, $content)) {
            $content = preg_replace($menuLinkPattern, '', $content);
            $this->line("  ✅ Lien Notifications dans la sidebar supprimé");
        } else {
            $this->line("  ℹ️  Aucun lien Notifications dans la sidebar");
        }

        // ============================================================
        // 3. Nettoyer les lignes vides multiples
        // ============================================================
        $content = preg_replace('/\n{3,}/', "\n\n", $content);

        // ============================================================
        // 4. Écrire
        // ============================================================
        File::put($fullPath, $content);

        $newSize = strlen($content);
        $diff = $originalSize - $newSize;
        $this->line("  ✅ {$path} mis à jour (-{$diff} octets)");

        // ============================================================
        // 5. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : page notifications supprimée du layout");
        $this->line("  • Modal notifications : conservée");
        $this->line("  • Lien footer modal : supprimé");
        $this->line("  • Lien sidebar : supprimé");
        $this->newLine();
        $this->info("👉 Testez : http://localhost:8000/admin/dashboard");

        return self::SUCCESS;
    }
}