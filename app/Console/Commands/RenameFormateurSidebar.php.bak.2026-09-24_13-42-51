<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class RenameFormateurSidebar extends Command
{
    protected $signature = 'project:rename-formateur-sidebar
                            {--backup : Sauvegarder le fichier existant (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Renomme les libellés de la sidebar formateur (Mes affectations → Demande affectations, etc.)';

    public function handle(): int
    {
        $this->info("✏️  Renommage des libellés de la sidebar formateur");
        $this->newLine();

        $path = 'resources/views/layouts/formateur.blade.php';
        $fullPath = base_path($path);

        if (!File::exists($fullPath)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
            File::copy($fullPath, $backupPath);
            $this->line("  💾 Backup : " . basename($backupPath));
        }

        $content = File::get($fullPath);
        $modified = false;

        // ============================================================
        // Remplacements
        // ============================================================
        $replacements = [
            'Mes affectations' => 'Demande affectations',
            'Mes sessions'     => 'Demande sessions',
        ];

        foreach ($replacements as $old => $new) {
            if (str_contains($content, $old)) {
                $content = str_replace($old, $new, $content);
                $this->line("  ✅ \"{$old}\" → \"{$new}\"");
                $modified = true;
            } else {
                $this->warn("  ⚠️  \"{$old}\" non trouvé dans le fichier");
            }
        }

        if (!$modified) {
            $this->error("❌ Aucun remplacement effectué");
            return self::FAILURE;
        }

        File::put($fullPath, $content);
        $size = round(strlen($content) / 1024, 2);
        $this->line("  ✅ {$path} mis à jour ({$size} Ko)");

        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : libellés renommés");

        return self::SUCCESS;
    }
}