<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Facades\Route;

class InspectProject extends Command
{
    protected $signature = 'inspect:project
                            {--focus= : Focus sur un module (formateur, session, ...)}
                            {--details : Afficher les détails}';

    protected $description = 'Inspection complète du projet Laravel';

    protected array $issues = [];
    protected array $ok = [];

    public function handle(): int
    {
        $this->line('');
        $this->line('╔════════════════════════════════════════════════════╗');
        $this->line('║   🔎 INSPECTION COMPLÈTE DU PROJET LARAVEL         ║');
        $this->line('╚════════════════════════════════════════════════════╝');
        $this->line('');

        $this->checkRoutes();
        $this->checkControllers();
        $this->checkViews();
        $this->checkFormateurChain(); // ⚡ focus spécial
        $this->checkBackupFiles();
        $this->checkCache();

        $this->printReport();

        return self::SUCCESS;
    }

    // ═════════════════════════════════════════════════════
    // 1. ROUTES
    // ═════════════════════════════════════════════════════
    private function checkRoutes(): void
    {
        $this->line('▶ 1. ROUTES');
        $routes = Route::getRoutes();

        $missingActions = [];
        foreach ($routes as $route) {
            $action = $route->getActionName();
            if (!str_contains($action, '@')) continue;

            [$class, $method] = explode('@', $action);
            if (!class_exists($class)) {
                $missingActions[] = "Controller inexistant : {$class}";
                continue;
            }
            if (!method_exists($class, $method)) {
                $missingActions[] = "Méthode manquante : {$class}@{$method}";
            }
        }

        if (empty($missingActions)) {
            $this->ok("Toutes les routes pointent vers des méthodes existantes ✅");
        } else {
            foreach ($missingActions as $m) {
                $this->issue("Route cassée : {$m}");
            }
        }
    }

    // ═════════════════════════════════════════════════════
    // 2. CONTROLLERS
    // ═════════════════════════════════════════════════════
    private function checkControllers(): void
    {
        $this->line('');
        $this->line('▶ 2. CONTROLLERS');

        $controllers = File::allFiles(app_path('Http/Controllers'));
        $total = 0;
        $empty = [];

        foreach ($controllers as $file) {
            if ($file->getExtension() !== 'php') continue;
            if (str_contains($file->getFilename(), '.bak')) continue;

            $total++;
            $content = File::get($file->getPathname());

            // Détecter les méthodes vides
            if (preg_match_all('/public function (\w+)\s*\([^)]*\)\s*\{\s*\}/s', $content, $m)) {
                foreach ($m[1] as $method) {
                    $empty[] = $file->getFilename() . " → {$method}() vide";
                }
            }
        }

        $this->ok("{$total} controllers analysés");

        if (!empty($empty)) {
            foreach ($empty as $e) {
                $this->issue("Méthode vide : {$e}");
            }
        }
    }

    // ═════════════════════════════════════════════════════
    // 3. VUES
    // ═════════════════════════════════════════════════════
    private function checkViews(): void
    {
        $this->line('');
        $this->line('▶ 3. VUES');

        $views = File::allFiles(resource_path('views'));
        $orphans = [];
        $allRoutes = collect(Route::getRoutes())->pluck('uri')->toArray();

        foreach ($views as $file) {
            $name = $file->getFilename();
            if (str_contains($name, '.bak')) continue;
            if ($name === 'welcome.blade.php') continue;

            // Vérifie si la vue est utilisée dans les controllers
            $viewName = str_replace(
                [resource_path('views') . DIRECTORY_SEPARATOR, '.blade.php', DIRECTORY_SEPARATOR],
                ['', '', '.'],
                $file->getPathname()
            );

            $used = false;
            foreach (File::allFiles(app_path()) as $php) {
                if (str_contains(File::get($php->getPathname()), $viewName)) {
                    $used = true;
                    break;
                }
            }
            if (!$used) {
                $orphans[] = $viewName;
            }
        }

        $this->ok(count($views) . " vues trouvées");
        if (!empty($orphans)) {
            foreach ($orphans as $o) {
                $this->issue("Vue orpheline (jamais utilisée) : {$o}");
            }
        }
    }

    // ═════════════════════════════════════════════════════
    // 4. CHAÎNE FORMATEUR (le focus)
    // ═════════════════════════════════════════════════════
    private function checkFormateurChain(): void
    {
        $this->line('');
        $this->line('▶ 4. ⚡ CHAÎNE MODAL FORMATEUR (prioritaire)');
        $this->line('');

        $checks = [
            'Controller create() existe' => function () {
                $c = File::get(app_path('Http/Controllers/Admin/FormateurController.php'));
                return preg_match('/public function create\s*\(/', $c);
            },
            'Controller create() renvoie JSON' => function () {
                $c = File::get(app_path('Http/Controllers/Admin/FormateurController.php'));
                return str_contains($c, 'response()->json') && str_contains($c, 'create');
            },
            'Controller store() existe' => function () {
                $c = File::get(app_path('Http/Controllers/Admin/FormateurController.php'));
                return preg_match('/public function store\s*\(/', $c);
            },
            'Partial _form.blade.php existe' => function () {
                return File::exists(resource_path('views/admin/formateurs/partials/_form.blade.php'));
            },
            'Partial contient id="formateurForm"' => function () {
                $p = resource_path('views/admin/formateurs/partials/_form.blade.php');
                return File::exists($p) && str_contains(File::get($p), 'id="formateurForm"');
            },
            'index.blade.php a #formateurModal' => function () {
                $p = resource_path('views/admin/formateurs/index.blade.php');
                return File::exists($p) && str_contains(File::get($p), 'id="formateurModal"');
            },
            'index.blade.php a #formateurFormContent' => function () {
                $p = resource_path('views/admin/formateurs/index.blade.php');
                return File::exists($p) && str_contains(File::get($p), 'formateurFormContent');
            },
            'index.blade.php a #submitBtn' => function () {
                $p = resource_path('views/admin/formateurs/index.blade.php');
                return File::exists($p) && str_contains(File::get($p), 'id="submitBtn"');
            },
            'Route admin.formateurs.create existe' => function () {
                return Route::has('admin.formateurs.create');
            },
            'Route admin.formateurs.store existe' => function () {
                return Route::has('admin.formateurs.store');
            },
            'Layout admin a @stack(scripts)' => function () {
                $p = resource_path('views/layouts/admin.blade.php');
                return File::exists($p) && str_contains(File::get($p), "@stack('scripts')");
            },
            'StoreFormateurRequest existe' => function () {
                return File::exists(app_path('Http/Requests/Formateur/StoreFormateurRequest.php'));
            },
        ];

        foreach ($checks as $label => $fn) {
            try {
                if ($fn()) {
                    $this->ok($label);
                } else {
                    $this->issue($label);
                }
            } catch (\Throwable $e) {
                $this->issue($label . ' → ' . $e->getMessage());
            }
        }

        // ── Test réel de la route AJAX ──
        $this->line('');
        $this->line('▶ Test live de la route create (AJAX) :');
        try {
            $request = \Illuminate\Http\Request::create(
                route('admin.formateurs.create'),
                'GET',
                [], [], [],
                ['HTTP_X-REQUESTED-WITH' => 'XMLHttpRequest', 'HTTP_ACCEPT' => 'application/json']
            );

            $response = app()->handle($request);
            $status = $response->getStatusCode();
            $body = $response->getContent();

            if ($status === 200) {
                $json = json_decode($body, true);
                if (isset($json['html'])) {
                    $this->ok("Route AJAX renvoie JSON avec 'html' ✅ (taille: " . strlen($json['html']) . " octets)");
                } else {
                    $this->issue("Route renvoie du JSON SANS clé 'html' ❌");
                    $this->line("   Réponse : " . substr($body, 0, 200));
                }
            } else {
                $this->issue("Route AJAX renvoie HTTP {$status} ❌");
                $this->line("   Body : " . substr($body, 0, 200));
            }
        } catch (\Throwable $e) {
            $this->issue("Erreur test AJAX : " . $e->getMessage());
        }
    }

    // ═════════════════════════════════════════════════════
    // 5. FICHIERS .BAK
    // ═════════════════════════════════════════════════════
    private function checkBackupFiles(): void
    {
        $this->line('');
        $this->line('▶ 5. FICHIERS .BAK');

        $baks = collect(File::allFiles(app_path()))
            ->filter(fn($f) => str_contains($f->getFilename(), '.bak'));

        if ($baks->isEmpty()) {
            $this->ok("Aucun fichier .bak dans app/");
        } else {
            $this->issue($baks->count() . " fichiers .bak encore présents dans app/");
        }
    }

    // ═════════════════════════════════════════════════════
    // 6. CACHE
    // ═════════════════════════════════════════════════════
    private function checkCache(): void
    {
        $this->line('');
        $this->line('▶ 6. CACHE');

        $compiledViews = count(File::files(storage_path('framework/views')));
        $this->line("   Vues compilées : {$compiledViews}");

        if (File::exists(base_path('bootstrap/cache/config.php'))) {
            $this->warn("   ⚠️  Config cachée (bootstrap/cache/config.php) → peut masquer vos modifications");
        }
        if (File::exists(base_path('bootstrap/cache/routes-v7.php'))) {
            $this->warn("   ⚠️  Routes cachées → peut masquer vos modifications");
        }
    }

    // ═════════════════════════════════════════════════════
    // RAPPORT FINAL
    // ═════════════════════════════════════════════════════
    private function printReport(): void
    {
        $this->line('');
        $this->line('╔════════════════════════════════════════════════════╗');
        $this->line('║                    📊 RAPPORT                      ║');
        $this->line('╚════════════════════════════════════════════════════╝');
        $this->line('');

        $this->line("  ✅ OK        : " . count($this->ok));
        $this->line("  ❌ PROBLÈMES : " . count($this->issues));
        $this->line('');

        if (!empty($this->issues)) {
            $this->warn("  🔧 ACTIONS À FAIRE :");
            foreach ($this->issues as $i => $issue) {
                $this->line("     " . ($i + 1) . ". {$issue}");
            }
        } else {
            $this->info("  🎉 Aucun problème détecté !");
        }
    }

    private function ok(string $msg): void
    {
        $this->ok[] = $msg;
        $this->line("   <fg=green>✅</> {$msg}");
    }

    private function issue(string $msg): void
    {
        $this->issues[] = $msg;
        $this->line("   <fg=red>❌</> {$msg}");
    }
}