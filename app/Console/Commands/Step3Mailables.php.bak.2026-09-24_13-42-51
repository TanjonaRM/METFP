<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class Step3Mailables extends Command
{
    protected $signature = 'step3:mailables';
    protected $description = 'Crée les Mailables et vues email';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   📧 ÉTAPE 3 : MAILABLES + VUES EMAIL                     ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');

        // Dossiers
        $mailDir = app_path('Mail');
        if (!File::exists($mailDir)) File::makeDirectory($mailDir, 0755, true);

        $emailViewDir = resource_path('views/emails');
        if (!File::exists($emailViewDir)) File::makeDirectory($emailViewDir, 0755, true);

        // Mailables
        File::put($mailDir . '/FormateurApprouveMail.php', $this->approvedMail());
        $this->info('✅ FormateurApprouveMail.php');

        File::put($mailDir . '/FormateurRefuseMail.php', $this->refusedMail());
        $this->info('✅ FormateurRefuseMail.php');

        // Vues email
        File::put($emailViewDir . '/formateur-approuve.blade.php', $this->approvedView());
        $this->info('✅ emails/formateur-approuve.blade.php');

        File::put($emailViewDir . '/formateur-refuse.blade.php', $this->refusedView());
        $this->info('✅ emails/formateur-refuse.blade.php');

        $this->line('');
        $this->info('🎉 ÉTAPE 3 TERMINÉE !');
        $this->line('👉 Passez à l\'étape 4 : php artisan step4:views');

        return self::SUCCESS;
    }

    private function approvedMail(): string
    {
        return <<<'PHP'
<?php

namespace App\Mail;

use Illuminate\Bus\Queueable;
use Illuminate\Mail\Mailable;
use Illuminate\Queue\SerializesModels;

class FormateurApprouveMail extends Mailable
{
    use Queueable, SerializesModels;

    public function __construct(
        public $formateur,
        public ?string $messageAdmin = null
    ) {}

    public function build()
    {
        return $this->subject('✅ Votre inscription a été approuvée — SG Formateurs')
                    ->view('emails.formateur-approuve');
    }
}
PHP;
    }

    private function refusedMail(): string
    {
        return <<<'PHP'
<?php

namespace App\Mail;

use Illuminate\Bus\Queueable;
use Illuminate\Mail\Mailable;
use Illuminate\Queue\SerializesModels;

class FormateurRefuseMail extends Mailable
{
    use Queueable, SerializesModels;

    public function __construct(
        public $formateur,
        public ?string $motif = null
    ) {}

    public function build()
    {
        return $this->subject('❌ Votre inscription — SG Formateurs')
                    ->view('emails.formateur-refuse');
    }
}
PHP;
    }

    private function approvedView(): string
    {
        return <<<'BLADE'
<!DOCTYPE html>
