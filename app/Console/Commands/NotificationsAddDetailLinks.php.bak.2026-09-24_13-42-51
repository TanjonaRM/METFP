<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class NotificationsAddDetailLinks extends Command
{
    protected $signature = 'project:notifications-add-detail-links
                            {--backup : Sauvegarder le fichier (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Ajoute des liens détaillés dans chaque notification de la modal';

    public function handle(): int
    {
        $this->info("🔗 Ajout des liens détaillés dans les notifications");
        $this->newLine();

        if (!$this->option('force') && !$this->confirm('Continuer ?', true)) {
            $this->warn('Annulé.');
            return self::FAILURE;
        }

        // ============================================================
        // 1. Créer une page "Détail de notification"
        // ============================================================
        $controllerPath = base_path('app/Http/Controllers/Admin/NotificationController.php');

        if (!File::exists($controllerPath)) {
            $this->error("❌ NotificationController introuvable");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            File::copy($controllerPath, $controllerPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        $controllerContent = File::get($controllerPath);

        // Ajouter la méthode show() si absente
        if (!str_contains($controllerContent, 'public function show(')) {
            $showMethod = <<<'PHP'

    /**
     * Affiche le détail d'une notification
     */
    public function show(int $id)
    {
        $notification = Notification::findOrFail($id);

        // Marquer comme lue automatiquement
        if (!$notification->lu) {
            $notification->update(['lu' => true]);
        }

        // Si la notification a un lien, rediriger
        if ($notification->lien) {
            return redirect($notification->lien);
        }

        // Sinon, afficher la page de détail
        return view('admin.notifications.show', compact('notification'));
    }

PHP;

            $lastBrace = strrpos($controllerContent, '}');
            $controllerContent = substr_replace($controllerContent, $showMethod, $lastBrace, 0);

            File::put($controllerPath, $controllerContent);
            $this->line("  ✅ Méthode show() ajoutée au contrôleur");
        } else {
            $this->line("  ℹ️  Méthode show() existe déjà");
        }

        // ============================================================
        // 2. Créer la vue show.blade.php
        // ============================================================
        $viewPath = base_path('resources/views/admin/notifications/show.blade.php');

        if (!File::exists(dirname($viewPath))) {
            File::makeDirectory(dirname($viewPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($viewPath)) {
            File::copy($viewPath, $viewPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($viewPath, $this->getShowView());
        $this->line("  ✅ Vue show.blade.php créée");

        // ============================================================
        // 3. Ajouter la route show
        // ============================================================
        $routesPath = base_path('routes/admin.php');

        if (!File::exists($routesPath)) {
            $this->error("  ❌ routes/admin.php introuvable");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            File::copy($routesPath, $routesPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        $routesContent = File::get($routesPath);

        if (!str_contains($routesContent, "notifications.show")) {
            // Ajouter la route dans le groupe notifications
            $pattern = "/(Route::get\('\/count',\s*\[NotificationController::class,\s*'count'\]\)->name\('count'\);)/";

            if (preg_match($pattern, $routesContent)) {
                $routesContent = preg_replace(
                    $pattern,
                    '$1' . "\n            Route::get('/{id}/show', [NotificationController::class, 'show'])->where('id', '[0-9]+')->name('show');",
                    $routesContent
                );
                File::put($routesPath, $routesContent);
                $this->line("  ✅ Route notifications.show ajoutée");
            } else {
                $this->warn("  ⚠️  Impossible d'ajouter la route show");
            }
        } else {
            $this->line("  ℹ️  Route show existe déjà");
        }

        // ============================================================
        // 4. Modifier la modal pour ajouter les liens
        // ============================================================
        $layoutPath = base_path('resources/views/layouts/admin.blade.php');

        if (!File::exists($layoutPath)) {
            $this->error("  ❌ Layout admin introuvable");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            File::copy($layoutPath, $layoutPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        $layoutContent = File::get($layoutPath);

        // Remplacer le rendu de chaque notification
        $oldRenderPattern = '/list\.innerHTML = notifications\.map\(n => \{[\s\S]*?\}\)\.join\(\'\'\);/';

        $newRender = <<<'JS'
list.innerHTML = notifications.map(n => {
                const style = icons[n.type] || icons.info;
                const luClass = n.lu ? 'opacity-60' : '';
                const bgClass = n.lu ? '' : 'bg-emerald-50/20';
                const titre = escapeHtml(n.titre || 'Sans titre');
                const message = escapeHtml(n.message || '');
                const date = escapeHtml(n.date || '');
                const icone = escapeHtml(n.icone || 'info');
                const lien = n.lien || '';
                const showUrl = `/admin/notifications/${n.id}/show`;

                return `
                    <div class="group flex items-start gap-4 px-6 py-4
                                border-b border-slate-100 last:border-0
                                hover:bg-slate-50 transition ${luClass} ${bgClass}">

                        <div class="w-10 h-10 rounded-lg ${style.bg} border ${style.border}
                                    flex items-center justify-center shrink-0">
                            <span class="material-symbols-rounded ${style.color} text-[20px]">${icone}</span>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-2">
                                <div class="font-bold text-slate-900 text-[14px]">${titre}</div>
                                <div class="text-[11px] text-slate-400 whitespace-nowrap">${date}</div>
                            </div>
                            <div class="text-[13px] text-slate-600 mt-1 leading-relaxed">${message}</div>

                            <div class="flex flex-wrap items-center gap-3 mt-3">

                                <a href="${showUrl}"
                                   class="inline-flex items-center gap-1 text-[12px] font-semibold
                                          text-emerald-700 hover:text-emerald-800 transition">
                                    <span class="material-symbols-rounded text-[14px]">visibility</span>
                                    Voir en détail
                                </a>

                                ${lien ? `
                                    <a href="${lien}"
                                       class="inline-flex items-center gap-1 text-[12px] font-semibold
                                              text-blue-600 hover:text-blue-700 transition">
                                        <span class="material-symbols-rounded text-[14px]">link</span>
                                        Aller à la ressource
                                    </a>
                                ` : ''}

                                ${!n.lu ? `
                                    <button type="button"
                                            onclick="marquerCommeLu(${n.id})"
                                            class="inline-flex items-center gap-1 text-[12px] font-semibold
                                                   text-slate-500 hover:text-slate-700 transition">
                                        <span class="material-symbols-rounded text-[14px]">done</span>
                                        Marquer comme lu
                                    </button>
                                ` : ''}

                                <button type="button"
                                        onclick="supprimerNotification(${n.id})"
                                        class="inline-flex items-center gap-1 text-[12px] font-semibold
                                               text-red-500 hover:text-red-700 transition ml-auto">
                                    <span class="material-symbols-rounded text-[14px]">delete</span>
                                    Supprimer
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
JS;

        if (preg_match($oldRenderPattern, $layoutContent)) {
            $layoutContent = preg_replace($oldRenderPattern, $newRender, $layoutContent);
            $this->line("  ✅ Modal : liens 'Voir en détail' + 'Aller à la ressource' ajoutés");
        } else {
            $this->warn("  ⚠️  Pattern non trouvé dans la modal");
        }

        File::put($layoutPath, $layoutContent);
        $this->line("  ✅ Layout admin mis à jour");

        // ============================================================
        // 5. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('route:clear');
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS");
        $this->line("  • Méthode show() : NotificationController");
        $this->line("  • Vue : admin/notifications/show.blade.php");
        $this->line("  • Route : /admin/notifications/{id}/show");
        $this->line("  • Modal : 4 actions par notification");
        $this->newLine();
        $this->info("👉 Testez : http://localhost:8000/admin/dashboard");

        return self::SUCCESS;
    }

    // ============================================================
    // VUE SHOW
    // ============================================================
