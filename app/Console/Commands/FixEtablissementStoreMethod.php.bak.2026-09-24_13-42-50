<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixEtablissementStoreMethod extends Command
{
    protected $signature = 'fix:etablissement-store';
    protected $description = 'Corrige store() pour générer le code';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔧 CORRECTION store() — AUTO-GÉNÉRATION DU CODE         ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');

        $path = app_path('Http/Controllers/Admin/EtablissementController.php');

        if (!File::exists($path)) {
            $this->error("❌ Fichier introuvable");
            return self::FAILURE;
        }

        $content = File::get($path);
        $original = $content;

        // ═══════════════════════════════════════════════
        // 1. Afficher la méthode store() actuelle
        // ═══════════════════════════════════════════════
        $this->line('▶ 1. Méthode store() actuelle');

        if (preg_match('/public function store\s*\([^)]*\)\s*\{.*?\n    \}/s', $content, $m)) {
            $this->line('');
            foreach (explode("\n", $m[0]) as $line) {
                $this->line('   ' . $line);
            }
            $this->line('');
        } else {
            $this->error('   ❌ Méthode store() introuvable');
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // 2. Backup
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 2. Backup');
        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $this->info('   💾 Backup créé');

        // ═══════════════════════════════════════════════
        // 3. Nouvelle méthode store()
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 3. Remplacement de store()');

        $newStore = <<<'PHP'
    public function store(Request $request)
    {
        $validated = $request->validate([
            'code'                => 'nullable|string|unique:etablissements,code',
            'nom'                 => 'required|string|max:150',
            'type'                => 'required|in:CFP,LTP,Lycee,Autre',
            'region'              => 'nullable|string|max:100',
            'adresse'             => 'nullable|string|max:255',
            'contact_responsable' => 'nullable|string|max:150',
            'email'               => 'nullable|email|max:150',
            'statut'              => 'required|in:actif,inactif,suspendu',
        ]);

        // ⚡ Auto-génération du code : TYPE-PREMIER-MOT
        if (empty($validated['code'])) {
            $type = strtoupper(trim($validated['type'] ?? 'ETB'));
            $nom  = trim($validated['nom'] ?? '');

            // Retirer le type du début du nom si présent
            $nom = preg_replace('/^' . preg_quote($type, '/') . '\s+/i', '', $nom);

            // Prendre le premier mot
            $parts = preg_split('/[\s\-]+/', $nom);
            $mot   = strtoupper($parts[0] ?? 'X');

            $validated['code'] = $type . '-' . $mot;
        }

        $etablissement = EtablissementModel::create($validated);

        // Notification
        if (class_exists(\App\Services\NotificationService::class)) {
            \App\Services\NotificationService::etablissementCree(
                $etablissement->nom,
                route('admin.etablissements.show', $etablissement->id)
            );
        }

        return redirect()
            ->route('admin.etablissements.index')
            ->with('success', 'Établissement créé avec succès.');
    }
PHP;

        // Remplacer la méthode store() existante
        $pattern = '/public function store\s*\([^)]*\)\s*\{.*?\n    \}/s';

        if (preg_match($pattern, $content)) {
            $content = preg_replace($pattern, $newStore, $content, 1);
            $this->info('   ✅ Méthode store() remplacée');
        } else {
            $this->error('   ❌ Pattern store() introuvable');
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // 4. Sauvegarder
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 4. Sauvegarde');
        File::put($path, $content);
        $this->info('   ✅ Fichier enregistré');

        // ═══════════════════════════════════════════════
        // 5. Vérifier syntaxe
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 5. Vérification syntaxe PHP');

        $output = [];
        $returnCode = 0;
        exec('php -l "' . $path . '" 2>&1', $output, $returnCode);

        if ($returnCode === 0) {
            $this->info('   ✅ Syntaxe valide');
        } else {
            $this->error('   ❌ ERREUR :');
            foreach ($output as $o) $this->line('      ' . $o);
            File::put($path, $original);
            $this->warn('   🔄 Fichier restauré');
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // 6. Vérifier que la colonne code accepte NULL
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 6. Vérification colonne code');

        try {
            $columns = \Schema::getColumnListing('etablissements');
            if (in_array('code', $columns)) {
                $this->info('   ✅ Colonne "code" existe');
            } else {
                $this->error('   ❌ Colonne "code" manquante !');
            }
        } catch (\Throwable $e) {
            $this->warn('   ⚠️  Impossible de vérifier : ' . $e->getMessage());
        }

        // ═══════════════════════════════════════════════
        // 7. Vider les caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 7. Vidage des caches');
        $this->call('optimize:clear');
        $this->call('view:clear');
        $this->info('   ✅ Caches vidés');

        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 TERMINÉ                                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/etablissements');
        $this->line('   Créez un établissement : type=CFP, nom="CFP TANA"');
        $this->line('   → Code doit être : CFP-TANA');

        return self::SUCCESS;
    }
}