<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixMatriculeStyle extends Command
{
    protected $signature = 'fix:matricule-style {--readonly : Rendre le champ read-only (auto-généré)}';
    protected $description = 'Colorie le champ matricule en noir';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎨 COLORATION DU CHAMP MATRICULE                        ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');

        $path = resource_path('views/admin/formateurs/partials/_form.blade.php');

        if (!File::exists($path)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        // Backup
        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $this->line('💾 Backup créé');

        $content = File::get($path);
        $original = $content;

        // ═══════════════════════════════════════════════
        // 1. Ajouter text-black font-medium à la classe du champ matricule
        // ═══════════════════════════════════════════════

        // Regex pour trouver l'input matricule
        $pattern = '/(<input\s+type="text"\s+name="matricule"[^>]*class=")([^"]*)(")/s';

        if (preg_match($pattern, $content, $m)) {
            $classes = $m[2];

            // Ajouter les classes si pas déjà présentes
            $addClasses = [];
            if (!str_contains($classes, 'text-black'))    $addClasses[] = 'text-black';
            if (!str_contains($classes, 'font-medium'))   $addClasses[] = 'font-medium';

            if ($this->option('readonly')) {
                if (!str_contains($classes, 'bg-slate-50'))       $addClasses[] = 'bg-slate-50';
                if (!str_contains($classes, 'cursor-not-allowed')) $addClasses[] = 'cursor-not-allowed';
                if (!str_contains($classes, 'font-mono'))         $addClasses[] = 'font-mono';
            }

            if (!empty($addClasses)) {
                $newClasses = $classes . ' ' . implode(' ', $addClasses);
                $content = str_replace(
                    'class="' . $classes . '"',
                    'class="' . $newClasses . '"',
                    $content
                );
                $this->info('✅ Classes ajoutées : ' . implode(', ', $addClasses));
            } else {
                $this->line('   ℹ️  Les classes sont déjà présentes');
            }
        } else {
            $this->warn('   ⚠️  Impossible de trouver l\'input matricule');
        }

        // ═══════════════════════════════════════════════
        // 2. Si --readonly : ajouter l'attribut readonly
        // ═══════════════════════════════════════════════

        if ($this->option('readonly')) {
            $pattern = '/(<input\s+type="text"\s+name="matricule"[^>]*)(placeholder="[^"]*")/s';

            if (preg_match($pattern, $content, $m)) {
                if (!str_contains($m[1], 'readonly')) {
                    $content = str_replace(
                        $m[1] . $m[2],
                        $m[1] . 'readonly ' . $m[2],
                        $content
                    );
                    $this->info('✅ Attribut "readonly" ajouté');
                } else {
                    $this->line('   ℹ️  "readonly" déjà présent');
                }
            }
        }

        // ═══════════════════════════════════════════════
        // 3. Enregistrer
        // ═══════════════════════════════════════════════

        if ($content === $original) {
            $this->line('');
            $this->warn('⚠️  Aucune modification');
        } else {
            File::put($path, $content);
            $this->info('💾 Fichier enregistré');
        }

        // ═══════════════════════════════════════════════
        // 4. Vider les caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Vidage des caches');
        $this->call('view:clear');
        $this->call('optimize:clear');

        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 TERMINÉ                                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/formateurs');
        $this->line('   Cliquez "Ajouter un formateur"');
        $this->line('   Le champ Matricule doit être NOIR');

        return self::SUCCESS;
    }
}