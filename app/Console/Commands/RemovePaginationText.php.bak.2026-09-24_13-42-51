<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class RemovePaginationText extends Command
{
    protected $signature = 'remove:pagination-text
                            {--restore : Restaurer les modifications}';

    protected $description = 'Supprime le texte "Showing..." et les boutons Previous/Next';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎨 MASQUAGE PAGINATION (texte + boutons)                ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');

        if ($this->option('restore')) {
            return $this->restore();
        }

        // ═══════════════════════════════════════════════
        // Méthode 1 : Modifier la vue de pagination custom (si existe)
        // ═══════════════════════════════════════════════
        $this->line('▶ 1. Recherche de la vue de pagination custom');

        $paginationViews = [
            'vendor/pagination/tailwind.blade.php',
            'vendor/pagination/bootstrap-5.blade.php',
            'vendor/pagination/default.blade.php',
        ];

        $found = false;
        foreach ($paginationViews as $v) {
            $path = resource_path('views/' . $v);
            if (File::exists($path)) {
                $this->info("   ✅ Trouvé : {$v}");
                $this->maskPaginationView($path);
                $found = true;
            }
        }

        if (!$found) {
            $this->warn('   ⚠️  Aucune vue de pagination custom trouvée');
        }

        // ═══════════════════════════════════════════════
        // Méthode 2 : CSS global dans le layout admin
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 2. Injection CSS dans layouts/admin.blade.php');

        $layoutPath = resource_path('views/layouts/admin.blade.php');

        if (!File::exists($layoutPath)) {
            $this->error('   ❌ Layout introuvable');
            return self::FAILURE;
        }

        File::copy($layoutPath, $layoutPath . '.bak.' . date('Y-m-d_Hs'));

        $content = File::get($layoutPath);

        // Vérifier si déjà injecté
        if (str_contains($content, 'pagination-hidden-text')) {
            $this->warn('   ⏭️  CSS déjà injecté');
        } else {
            $css = <<<'CSS'

{{-- ═══════════════════════════════════════════════════════════ --}}
{{-- 🎨 Masquer le texte "Showing X to Y" et boutons Prev/Next --}}
{{-- ═══════════════════════════════════════════════════════════ --}}
<style id="pagination-hidden-text">
    /* Masquer le texte "Showing X to Y of Z results" */
    nav[role="navigation"] > div:first-child > p,
    nav[role="navigation"] > p:first-child,
    .pagination-info,
    nav[role="navigation"] div:first-child p {
        display: none !important;
    }

    /* Masquer le conteneur "Previous/Next" */
    nav[role="navigation"] > div:last-child > div:first-child > a:first-child,
    nav[role="navigation"] > div:last-child > div:last-child > a:last-child,
    .pagination-prev,
    .pagination-next,
    nav[role="navigation"] a[rel="prev"],
    nav[role="navigation"] a[rel="next"] {
        display: none !important;
    }

    /* Si les boutons sont dans des spans dans Tailwind pagination */
    nav[role="navigation"] span[aria-label*="Previous"],
    nav[role="navigation"] span[aria-label*="Next"],
    nav[role="navigation"] span.relative.inline-flex.items-center:first-child,
    nav[role="navigation"] span.relative.inline-flex.items-center:last-child {
        display: none !important;
    }
</style>
CSS;

            // Insérer avant </head>
            $headPos = strpos($content, '</head>');
            if ($headPos !== false) {
                $content = substr($content, 0, $headPos) . $css . "\n" . substr($content, $headPos);
                File::put($layoutPath, $content);
                $this->info('   ✅ CSS injecté dans <head>');
            } else {
                // Insérer à la fin du body si pas de </head>
                $bodyPos = strrpos($content, '</body>');
                if ($bodyPos !== false) {
                    $content = substr($content, 0, $bodyPos) . $css . "\n" . substr($content, $bodyPos);
                    File::put($layoutPath, $content);
                    $this->info('   ✅ CSS injecté avant </body>');
                } else {
                    $this->warn('   ⚠️  Impossible de trouver </head> ou </body>');
                }
            }
        }

        // ═══════════════════════════════════════════════
        // 3. Vider les caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 3. Vidage des caches');
        $this->call('view:clear');
        $this->call('optimize:clear');
        $this->info('   ✅ Caches vidés');

        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 TERMINÉ                                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/etablissements?page=2');
        $this->line('   Le texte "Showing..." et les boutons Prev/Next doivent disparaître');
        $this->line('   Les numéros (1, 2) restent visibles ✅');

        return self::SUCCESS;
    }

    private function maskPaginationView(string $path): void
    {
        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));

        $content = File::get($path);

        // Détecter la structure Tailwind pagination
        // On retire le bloc "Showing X to Y of Z" et les boutons Previous/Next

        // ═══════════════════════════════════════════════
        // Méthode : cacher avec style inline dans la vue
        // ═══════════════════════════════════════════════

        $maskCss = <<<'CSS'

    {{-- 🎨 Masquer le texte "Showing..." --}}
    <style>
        .hidden-pagination-text,
        nav[role="navigation"] > div:first-child > p,
        nav[role="navigation"] > p:first-child {
            display: none !important;
        }
    </style>
CSS;

        // Chercher où insérer (juste après <div> principal)
        if (str_contains($content, '<div class="flex items-center justify-between">')) {
            $content = str_replace(
                '<div class="flex items-center justify-between">',
                '<div class="flex items-center justify-between">' . $maskCss,
                $content
            );
        }

        // Remplacer les blocs "Previous" et "Next" par des éléments cachés
        // Tailwind pagination a ce genre de bloc :
        // <span class="relative inline-flex items-center px-2 py-2 text-sm font-medium text-gray-500 ...">
        //     Previous
        // </span>

        // On cache les <span> contenant "Previous" et "Next"
        $content = preg_replace(
            '/(<span[^>]*>)\s*(&laquo;\s*)?(Previous|Précédent|Previous)/iu',
            '$1<span style="display:none">',
            $content
        );

        $content = preg_replace(
            '/(<span[^>]*>)\s*(Next|Suivant|Next\s*)?(\s*&raquo;)/iu',
            '$1<span style="display:none">',
            $content
        );

        File::put($path, $content);
        $this->info('   ✅ Vue modifiée : ' . basename($path));
    }

    private function restore(): int
    {
        $this->line('▶ Restauration des backups');

        $targets = [
            resource_path('views/layouts/admin.blade.php'),
            resource_path('views/vendor/pagination/tailwind.blade.php'),
            resource_path('views/vendor/pagination/bootstrap-5.blade.php'),
        ];

        foreach ($targets as $target) {
            $backups = glob($target . '.bak.*');
            if (empty($backups)) continue;

            rsort($backups);
            $latest = $backups[0];

            File::copy($latest, $target);
            $this->info('   ✅ Restauré : ' . basename($target));
        }

        $this->call('view:clear');
        $this->call('optimize:clear');

        return self::SUCCESS;
    }
}