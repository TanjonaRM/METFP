<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class AutoGenerateMatricule extends Command
{
    protected $signature = 'fix:auto-matricule';
    protected $description = 'Auto-génère le matricule côté serveur (pas dans le formulaire)';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔧 AUTO-GÉNÉRATION DU MATRICULE                         ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');

        // ═══════════════════════════════════════════════
        // 1. MODIFIER StoreFormateurRequest
        // ═══════════════════════════════════════════════
        $this->line('▶ 1/4 — Modification de StoreFormateurRequest');

        $requestPath = app_path('Http/Requests/Formateur/StoreFormateurRequest.php');

        if (!File::exists($requestPath)) {
            $this->error("❌ Fichier introuvable : {$requestPath}");
            return self::FAILURE;
        }

        File::copy($requestPath, $requestPath . '.bak.' . date('Y-m-d_His'));
        $this->line('   💾 Backup créé');

        $content = File::get($requestPath);

        // Retirer 'required' de la règle matricule
        $content = preg_replace(
            "/'matricule'\s*=>\s*\[[^\]]*\]/",
            "'matricule'        => ['nullable', 'string', 'max:50', 'unique:formateurs,matricule'],",
            $content
        );

        File::put($requestPath, $content);
        $this->info('   ✅ Règle "required" retirée de matricule');

        // ═══════════════════════════════════════════════
        // 2. MODIFIER FormateurController@store
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 2/4 — Modification de FormateurController@store');

        $controllerPath = app_path('Http/Controllers/Admin/FormateurController.php');

        if (!File::exists($controllerPath)) {
            $this->error("❌ Controller introuvable");
            return self::FAILURE;
        }

        File::copy($controllerPath, $controllerPath . '.bak.' . date('Y-m-d_His'));
        $this->line('   💾 Backup créé');

        $controllerContent = File::get($controllerPath);

        // Injecter l'auto-génération du matricule AVANT FormateurModel::create
        if (preg_match('/(\$formateur\s*=\s*FormateurModel::create\()/s', $controllerContent, $m)) {
            $insert = <<<'PHP'
// ⚡ AUTO-GÉNÉRATION DU MATRICULE
        if (empty($data['matricule'])) {
            $lastFormateur = FormateurModel::orderBy('id', 'desc')->first();
            $nextNum = $lastFormateur ? ((int) str_replace('FORM-', '', $lastFormateur->matricule)) + 1 : 1;
            $data['matricule'] = 'FORM-' . str_pad($nextNum, 3, '0', STR_PAD_LEFT);
        }

        $formateur = FormateurModel::create(
PHP;

            $controllerContent = preg_replace(
                '/\$formateur\s*=\s*FormateurModel::create\(/s',
                $insert,
                $controllerContent,
                1
            );

            File::put($controllerPath, $controllerContent);
            $this->info('   ✅ Auto-génération injectée dans store()');
        } else {
            $this->warn('   ⚠️  Pattern FormateurModel::create() introuvable');
            $this->line('   👉 Modifiez manuellement la méthode store() :');
            $this->line('');
            $this->line('   Ajoutez AVANT $formateur = FormateurModel::create($data);');
            $this->line('');
            $this->line('   if (empty($data[\'matricule\'])) {');
            $this->line('       $last = FormateurModel::orderBy(\'id\', \'desc\')->first();');
            $this->line('       $next = $last ? ((int) str_replace(\'FORM-\', \'\', $last->matricule)) + 1 : 1;');
            $this->line('       $data[\'matricule\'] = \'FORM-\' . str_pad($next, 3, \'0\', STR_PAD_LEFT);');
            $this->line('   }');
        }

        // ═══════════════════════════════════════════════
        // 3. AFFICHER LE MATRICULE AUTO-GÉNÉRÉ dans create()
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 3/4 — Injection du prochain matricule dans create()');

        $controllerContent = File::get($controllerPath);

        // Modifier create() pour passer $nextMatricule à la vue
        if (preg_match('/(\$etablissements\s*=\s*EtablissementModel::orderBy\([^;]+;)/s', $controllerContent, $m)) {
            $insertAfter = $m[1] . "\n\n        // ⚡ Calcul du prochain matricule pour l'affichage
        \$lastFormateur = FormateurModel::orderBy('id', 'desc')->first();
        \$nextNum = \$lastFormateur ? ((int) str_replace('FORM-', '', \$lastFormateur->matricule)) + 1 : 1;
        \$nextMatricule = 'FORM-' . str_pad(\$nextNum, 3, '0', STR_PAD_LEFT);";

            $controllerContent = str_replace($m[1], $insertAfter, $controllerContent);

            // Ajouter 'nextMatricule' dans les vues et compact()
            $controllerContent = str_replace(
                "'filieres'       => \$filieres,",
                "'filieres'       => \$filieres,\n                'nextMatricule'  => \$nextMatricule ?? '',",
                $controllerContent
            );

            $controllerContent = str_replace(
                "compact('etablissements', 'filieres')",
                "compact('etablissements', 'filieres', 'nextMatricule')",
                $controllerContent
            );

            File::put($controllerPath, $controllerContent);
            $this->info('   ✅ $nextMatricule injecté');
        } else {
            $this->warn('   ⚠️  Impossible d\'injecter $nextMatricule');
        }

        // ═══════════════════════════════════════════════
        // 4. MODIFIER form.blade.php (champ readonly + value)
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 4/4 — Modification du formulaire form.blade.php');

        $formPath = resource_path('views/admin/formateurs/partials/form.blade.php');

        if (!File::exists($formPath)) {
            $this->warn('   ⚠️  Fichier introuvable : form.blade.php');
            $this->line('   👉 Modifiez manuellement le champ matricule :');
            $this->line('      Ajoutez : readonly value="{{ old(\'matricule\', $nextMatricule ?? \'\') }}"');
            $this->line('      Classe : text-black font-mono font-semibold bg-slate-50');
        } else {
            File::copy($formPath, $formPath . '.bak.' . date('Y-m-d_His'));
            $this->line('   💾 Backup créé');

            $formContent = File::get($formPath);

            // Trouver l'input matricule et le transformer
            $formContent = preg_replace_callback(
                '/(<input\b[^>]*name="matricule"[^>]*>)/s',
                function ($m) {
                    $input = $m[1];

                    // Ajouter readonly
                    if (!str_contains($input, 'readonly')) {
                        $input = preg_replace(
                            '/(<input\b)/',
                            '$1 readonly',
                            $input,
                            1
                        );
                    }

                    // Ajouter les classes
                    if (preg_match('/class="([^"]*)"/', $input, $cm)) {
                        $classes = $cm[1];
                        $add = [];
                        if (!str_contains($classes, 'text-black')) $add[] = 'text-black';
                        if (!str_contains($classes, 'font-mono')) $add[] = 'font-mono';
                        if (!str_contains($classes, 'font-semibold')) $add[] = 'font-semibold';
                        if (!str_contains($classes, 'bg-slate-50')) $add[] = 'bg-slate-50';
                        if (!str_contains($classes, 'cursor-not-allowed')) $add[] = 'cursor-not-allowed';

                        if (!empty($add)) {
                            $input = str_replace(
                                'class="' . $classes . '"',
                                'class="' . $classes . ' ' . implode(' ', $add) . '"',
                                $input
                            );
                        }
                    }

                    // Remplacer la valeur
                    $input = preg_replace(
                        '/value="[^"]*"/',
                        'value="{{ old(\'matricule\', $nextMatricule ?? \'\') }}"',
                        $input
                    );

                    return $input;
                },
                $formContent
            );

            File::put($formPath, $formContent);
            $this->info('   ✅ Champ matricule : readonly + noir + auto-généré');
        }

        // ═══════════════════════════════════════════════
        // Vidage caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ Vidage des caches');
        $this->call('view:clear');
        $this->call('optimize:clear');

        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🎉 TERMINÉ                                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Résultat attendu :');
        $this->line('   • Le champ matricule affiche déjà : FORM-XXX');
        $this->line('   • Il est en NOIR, non-éditable (readonly)');
        $this->line('   • À l\'enregistrement, le serveur régénère si vide');
        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/formateurs');
        $this->line('   Cliquez "Ajouter un formateur" (Ctrl+F5)');

        return self::SUCCESS;
    }
}