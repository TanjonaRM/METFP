namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixFormateurAjaxModal extends Command
{
    protected $signature = 'fix:formateur-ajax-modal';
    protected $description = 'Corrige create() + crée partial _form.blade.php pour le modal AJAX';

    public function handle(): int
    {
        // ─────────────────────────────────────────────
        // 1. Créer le partial _form.blade.php
        // ─────────────────────────────────────────────
        $dir = resource_path('views/admin/formateurs/partials');
        if (!File::exists($dir)) {
            File::makeDirectory($dir, 0755, true);
        }

        $formPath = $dir . '/_form.blade.php';
        if (!File::exists($formPath)) {
            File::put($formPath, $this->getForm());
            $this->info("✅ Créé : partials/_form.blade.php");
        } else {
            $this->warn("⏭️  Existe déjà : partials/_form.blade.php (non écrasé)");
        }

        // ─────────────────────────────────────────────
        // 2. Corriger FormateurController@create
        // ─────────────────────────────────────────────
        $controllerPath = app_path('Http/Controllers/Admin/FormateurController.php');
        if (!File::exists($controllerPath)) {
            $this->error("❌ Controller introuvable : {$controllerPath}");
            return self::FAILURE;
        }

        $content = File::get($controllerPath);

        // Chercher la méthode create existante
        if (preg_match('/public function create\s*\([^)]*\)\s*\{.*?\n    \}/s', $content, $m)) {
            $oldMethod = $m[0];
            $newMethod = $this->getCreateMethod();

            $content = str_replace($oldMethod, $newMethod, $content);

            File::copy($controllerPath, $controllerPath . '.bak.' . date('Y-m-d_His'));
            File::put($controllerPath, $content);

            $this->info("✅ FormateurController@create corrigée");
        } else {
            $this->warn("⚠️  Méthode create() introuvable dans FormateurController.");
            $this->line("👉 Ajoutez manuellement cette méthode :");
            $this->newLine();
            $this->line($this->getCreateMethod());
        }

        $this->newLine();
        $this->info("🎉 Terminé !");
        $this->line("👉 Étapes suivantes :");
        $this->line("   1. php artisan view:clear");
        $this->line("   2. php artisan optimize:clear");
        $this->line("   3. Recharger /admin/formateurs");

        return self::SUCCESS;
    }

    private function getCreateMethod(): string
    {
        return <<<'PHP'
    public function create()
    {
        $etablissements = EtablissementModel::orderBy('nom')->get();
        $filieres       = FiliereModel::orderBy('libelle')->get();

        // Requête AJAX → renvoyer JSON avec le HTML du formulaire
        if (request()->ajax() || request()->wantsJson()) {
            $html = view('admin.formateurs.partials._form', compact('etablissements', 'filieres'))->render();
            return response()->json(['html' => $html]);
        }

        // Requête normale → vue complète
        return view('admin.formateurs.create', compact('etablissements', 'filieres'));
    }
PHP;
    }

