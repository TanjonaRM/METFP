<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixLoginStatut extends Command
{
    protected $signature = 'fix:login-statut';
    protected $description = 'Le LoginController vérifie le statut avant connexion';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔐 LOGIN VÉRIFIE LE STATUT                              ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');

        $path = app_path('Http/Controllers/Auth/Formateur/LoginController.php');

        if (!File::exists($path)) {
            $this->error('❌ LoginController introuvable');
            return self::FAILURE;
        }

        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $this->line('💾 Backup créé');

        File::put($path, $this->getNewLoginController());
        $this->info('✅ LoginController mis à jour');

        // Vérifier syntaxe
        $output = [];
        $rc = 0;
        exec('php -l "' . $path . '" 2>&1', $output, $rc);
        if ($rc === 0) {
            $this->info('✅ Syntaxe valide');
        } else {
            $this->error('❌ Erreur syntaxe');
            foreach ($output as $o) $this->line('   ' . $o);
            return self::FAILURE;
        }

        $this->call('optimize:clear');
        $this->call('view:clear');

        $this->line('');
        $this->info('🎉 TERMINÉ !');
        $this->line('');
        $this->line('👉 Testez :');
        $this->line('   1. Créez un nouveau compte formateur');
        $this->line('   2. Essayez de vous connecter');
        $this->line('   3. → Message : "En attente de validation"');

        return self::SUCCESS;
    }

    private function getNewLoginController(): string
    {
        return <<<'PHP'
<?php

namespace App\Http\Controllers\Auth\Formateur;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;

class LoginController extends Controller
{
    public function showLoginForm()
    {
        if (Auth::guard('formateur')->check()) {
            return redirect()->route('formateur.dashboard');
        }
        return view('formateur.auth.login');
    }

    public function login(Request $request)
    {
        $request->validate([
            'email'    => 'required|email',
            'password' => 'required|string',
        ]);

        $credentials = $request->only('email', 'password');

        // 1. Tenter l'authentification
        if (!Auth::guard('formateur')->attempt($credentials, $request->filled('remember'))) {
            return back()
                ->withInput($request->only('email'))
                ->withErrors(['email' => 'Identifiants incorrects.']);
        }

        $formateur = Auth::guard('formateur')->user();

        // 2. Vérifier le statut
        if ($formateur->statut !== 'actif') {
            Auth::guard('formateur')->logout();

            $messages = [
                'en_attente' => '⏳ Votre inscription est en attente de validation. Vous recevrez un email dès qu\'un administrateur l\'aura traitée.',
                'refuse'     => '❌ Votre inscription a été refusée' . ($formateur->motif_refus ? ' : ' . $formateur->motif_refus : '.'),
                'suspendu'   => '⛔ Votre compte a été suspendu. Contactez l\'administration.',
                'inactif'    => '⚠️ Votre compte est inactif.',
            ];

            return back()
                ->withInput($request->only('email'))
                ->withErrors([
                    'email' => $messages[$formateur->statut] ?? 'Accès refusé.',
                ]);
        }

        // 3. Régénérer la session et rediriger
        $request->session()->regenerate();

        return redirect()->intended(route('formateur.dashboard'));
    }
}
PHP;
    }
}