namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class InstallHomePage extends Command
{
    protected $signature = 'project:install-home
                            {--backup : Sauvegarder les fichiers existants (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Installe la page d\'accueil réorganisée (welcome + guest layout)';

    public function handle(): int
    {
        $this->info("🎨 Installation de la page d'accueil réorganisée");
        $this->newLine();

        // Confirmation
        if (!$this->option('force') && !$this->confirm('Cela va remplacer welcome.blade.php et guest.blade.php. Continuer ?', true)) {
            $this->warn('Installation annulée.');
            return self::FAILURE;
        }

        $files = $this->getFiles();
        $count = 0;

        foreach ($files as $path => $content) {
            $fullPath = base_path($path);
            $dir = dirname($fullPath);

            // Créer le dossier si nécessaire
            if (!File::exists($dir)) {
                File::makeDirectory($dir, 0755, true);
            }

            // Backup si demandé
            if ($this->option('backup') && File::exists($fullPath)) {
                $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
                File::copy($fullPath, $backupPath);
                $this->line("  💾 Backup : {$path} → " . basename($backupPath));
            }

            // Écrire le fichier
            File::put($fullPath, $content);

            $size = round(strlen($content) / 1024, 2);
            $this->line("  ✅ {$path} ({$size} Ko)");
            $count++;
        }

        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : {$count} fichier(s) installé(s) !");
        $this->info("👉 Ouvrez http://localhost:8000/ pour voir le résultat");

        return self::SUCCESS;
    }

    protected function getFiles(): array
    {
        return [
            'resources/views/layouts/guest.blade.php' => $this->getGuestLayout(),
            'resources/views/welcome.blade.php'       => $this->getWelcomePage(),
        ];
    }

