<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class InspectNotificationService extends Command
{
    protected $signature = 'inspect:notification-service';
    protected $description = 'Inspecte la classe NotificationService';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔍 INSPECTION NOTIFICATIONSERVICE                       ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');

        // ═══════════════════════════════════════════════
        // 1. Chercher le fichier
        // ═══════════════════════════════════════════════
        $candidates = [
            app_path('Services/NotificationService.php'),
            app_path('Services/Notifications/NotificationService.php'),
            app_path('Domain/Notifications/Services/NotificationService.php'),
        ];

        $path = null;
        foreach ($candidates as $c) {
            if (File::exists($c)) {
                $path = $c;
                break;
            }
        }

        // Recherche large
        if (!$path) {
            foreach (File::allFiles(app_path()) as $f) {
                if ($f->getFilename() === 'NotificationService.php') {
                    $path = $f->getPathname();
                    break;
                }
            }
        }

        if (!$path) {
            $this->error('❌ NotificationService.php introuvable');
            return self::FAILURE;
        }

        $this->line('');
        $this->info("📄 Fichier : {$path}");
        $this->line('📦 Taille : ' . File::size($path) . ' octets');
        $this->line('');

        // ═══════════════════════════════════════════════
        // 2. Contenu COMPLET
        // ═══════════════════════════════════════════════
        $this->line('═══════════════════════════════════════════════════════════');
        $this->line('📖 CONTENU COMPLET');
        $this->line('═══════════════════════════════════════════════════════════');

        $content = File::get($path);
        $lines = explode("\n", $content);

        foreach ($lines as $i => $line) {
            $this->line(sprintf('%4d │ %s', $i + 1, $line));
        }

        // ═══════════════════════════════════════════════
        // 3. Résumé des méthodes
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('═══════════════════════════════════════════════════════════');
        $this->line('📊 RÉSUMÉ DES MÉTHODES');
        $this->line('═══════════════════════════════════════════════════════════');

        preg_match_all(
            '/public\s+(static\s+)?function\s+(\w+)\s*\(([^)]*)\)/',
            $content,
            $matches,
            PREG_SET_ORDER
        );

        if (empty($matches)) {
            $this->warn('   ⚠️  Aucune méthode publique');
        } else {
            foreach ($matches as $m) {
                $isStatic = !empty($m[1]);
                $method = $m[2];
                $params = trim($m[3]);

                $this->line('');
                $this->info("   ✅ {$method}()");
                $this->line('      Static : ' . ($isStatic ? 'OUI' : 'NON'));
                $this->line('      Paramètres : ' . ($params ?: '(aucun)'));
            }
        }

        return self::SUCCESS;
    }
}