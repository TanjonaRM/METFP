<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class InstallSessionRequestComplete extends Command
{
    protected $signature = 'project:install-session-request-complete
                            {--backup : Sauvegarder les fichiers (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Installe le bouton + modal de demande de session avec workflow d\'approbation';

    public function handle(): int
    {
        $this->info("🎯 Installation : Demande de session complète");
        $this->newLine();

        if (!$this->option('force') && !$this->confirm('Installer le module ?', true)) {
            $this->warn('Annulé.');
            return self::FAILURE;
        }

        // ============================================================
        // 1. Vue formateur : demandes sessions (avec bouton + modal)
        // ============================================================
        $formateurViewPath = base_path('resources/views/formateur/demandes/sessions.blade.php');

        if (!File::exists(dirname($formateurViewPath))) {
            File::makeDirectory(dirname($formateurViewPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($formateurViewPath)) {
            File::copy($formateurViewPath, $formateurViewPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($formateurViewPath, $this->getFormateurView());
        $this->line("  ✅ Vue formateur/demandes/sessions.blade.php");

        // ============================================================
        // 2. Vue admin : demandes sessions
        // ============================================================
        $adminViewPath = base_path('resources/views/admin/demandes/sessions/index.blade.php');

        if (!File::exists(dirname($adminViewPath))) {
            File::makeDirectory(dirname($adminViewPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($adminViewPath)) {
            File::copy($adminViewPath, $adminViewPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($adminViewPath, $this->getAdminView());
        $this->line("  ✅ Vue admin/demandes/sessions/index.blade.php");

        // ============================================================
        // 3. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : module demandes sessions installé");
        $this->line("  • Formateur : bouton vert + modal complète");
        $this->line("  • Admin : approbation avec message");
        $this->line("  • Notifications automatiques dans les 2 sens");

        return self::SUCCESS;
    }

