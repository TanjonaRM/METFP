    // ═══════════════════════════════════════════════════════
    // LOGIQUE PRINCIPALE
    // ═══════════════════════════════════════════════════════
    private function processModule(string $singular, string $plural, string $lowerPlural, string $fields): void
    {
        // ─────────────────────────────────────────────
        // 1. Créer partials/_form.blade.php
        // ─────────────────────────────────────────────
        $partialPath = resource_path("views/admin/{$lowerPlural}/partials/_form.blade.php");

        if (File::exists($partialPath)) {
            $this->warn("⏭️  _form.blade.php existe déjà (skip)");
        } else {
            File::put($partialPath, $this->getFormPartial($fields));
            $this->info("✅ Créé : partials/_form.blade.php");
        }

        // ─────────────────────────────────────────────
        // 2. Modifier le Controller create()
        // ─────────────────────────────────────────────
        $this->updateController($singular, $lowerPlural);

        // ─────────────────────────────────────────────
        // 3. Créer le modal + JS
        // ─────────────────────────────────────────────
        $modalPath = resource_path("views/admin/{$lowerPlural}/partials/modal-create.blade.php");

        if (File::exists($modalPath)) {
            $this->warn("⏭️  modal-create.blade.php existe déjà (skip)");
        } else {
            File::put($modalPath, $this->getModalPartial($singular, $lowerPlural));
            $this->info("✅ Créé : partials/modal-create.blade.php");
        }

        // ─────────────────────────────────────────────
        // 4. Injecter @include dans index.blade.php
        // ─────────────────────────────────────────────
        $this->injectModalIntoIndex($singular, $lowerPlural);
    }

    // ═══════════════════════════════════════════════════════
    // MODIFIER LE CONTROLLER
    // ═══════════════════════════════════════════════════════
    private function updateController(string $singular, string $lowerPlural): void
    {
        $path = app_path("Http/Controllers/Admin/{$singular}Controller.php");

        if (!File::exists($path)) {
            $this->error("❌ Controller introuvable : {$singular}Controller.php");
            return;
        }

        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $content = File::get($path);

        // Vérifier si déjà modifié
        if (str_contains($content, 'response()->json') && str_contains($content, '_form')) {
            $this->warn("⏭️  Controller déjà modifié (skip)");
            return;
        }

        // Trouver la méthode create()
        $pattern = '/public function create\s*\([^)]*\)\s*\{.*?\n    \}/s';

        if (!preg_match($pattern, $content, $m)) {
            $this->error("❌ Méthode create() introuvable dans {$singular}Controller");
            return;
        }

        // Nouvelle méthode create()
        $newCreate = $this->getNewCreateMethod($singular, $lowerPlural);

        $content = preg_replace($pattern, $newCreate, $content, 1);
        File::put($path, $content);
        $this->info("✅ Controller @create modifié (renvoie JSON si AJAX)");
    }

    private function getNewCreateMethod(string $singular, string $lowerPlural): string
    {
        if ($singular === 'Filiere') {
            return <<<'PHP'
    public function create(Request $request)
    {
        // Pour les selects
        $niveaux  = \Infrastructure\Persistence\Eloquent\Models\NiveauModel::orderBy('libelle')->get();
        $secteurs = \Infrastructure\Persistence\Eloquent\Models\SecteurModel::orderBy('libelle')->get();

        // Requête AJAX → JSON
        if ($request->ajax() || $request->wantsJson() || $request->header('X-Requested-With') === 'XMLHttpRequest') {
            $errors = session()->get('errors', new \Illuminate\Support\ViewErrorBag());

            $html = view('admin.filieres.partials._form', [
                'errors'    => $errors,
                'niveaux'   => $niveaux,
                'secteurs'  => $secteurs,
            ])->render();

            return response()->json(['html' => $html]);
        }

        return view('admin.filieres.create', compact('niveaux', 'secteurs'));
    }
PHP;
