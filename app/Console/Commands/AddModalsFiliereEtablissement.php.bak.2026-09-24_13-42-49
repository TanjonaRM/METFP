    // ═══════════════════════════════════════════════════════
    // INJECTER LE MODAL DANS index.blade.php
    // ═══════════════════════════════════════════════════════
    private function injectModalIntoIndex(string $singular, string $lowerPlural): void
    {
        $path = resource_path("views/admin/{$lowerPlural}/index.blade.php");

        if (!File::exists($path)) {
            $this->error("❌ index.blade.php introuvable");
            return;
        }

        File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
        $content = File::get($path);

        // Vérifier si déjà injecté
        if (str_contains($content, "modal-create")) {
            $this->warn("⏭️  Modal déjà présent dans index.blade.php (skip)");
            return;
        }

        // Injecter AVANT @endsection
        $includeLine = "@include('admin.{$lowerPlural}.partials.modal-create')";
        $lastEnd = strrpos($content, '@endsection');

        if ($lastEnd === false) {
            $this->warn("⚠️  @endsection introuvable — ajoutez manuellement : {$includeLine}");
            return;
        }

        $content = substr($content, 0, $lastEnd)
            . "\n" . $includeLine . "\n"
            . substr($content, $lastEnd);

        File::put($path, $content);
        $this->info("✅ @include injecté dans index.blade.php");
    }

