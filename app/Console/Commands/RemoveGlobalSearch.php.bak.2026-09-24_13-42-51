use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class RemoveGlobalSearch extends Command
{
    protected $signature = 'project:remove-global-search
                            {--backup : Sauvegarder le fichier existant (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Supprime la recherche globale AJAX (réécrit admin.blade.php)';

    public function handle(): int
    {
        $this->info("🗑️  Suppression de la recherche globale AJAX");
        $this->newLine();

        if (!$this->option('force') && !$this->confirm('Réécrire resources/views/layouts/admin.blade.php ?', true)) {
            $this->warn('Annulé.');
            return self::FAILURE;
        }

        $path = 'resources/views/layouts/admin.blade.php';
        $fullPath = base_path($path);

        if (!File::exists(dirname($fullPath))) {
            File::makeDirectory(dirname($fullPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($fullPath)) {
            $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
            File::copy($fullPath, $backupPath);
            $this->line("  💾 Backup : " . basename($backupPath));
        }

        $content = $this->getLayout();
        File::put($fullPath, $content);

        $size = round(strlen($content) / 1024, 2);
        $this->line("  ✅ {$path} ({$size} Ko)");

        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : recherche globale supprimée");

        return self::SUCCESS;
    }

