<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Facades\Artisan;

class RestoreAllRequests extends Command
{
    protected $signature = 'restore:all-requests';
    protected $description = 'Restaure/recrée tous les Form Requests cassés';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line('║   🔧 RESTAURATION DES FORM REQUESTS                      ║');
        $this->line('╚══════════════════════════════════════════════════════════╝');

        $historyPath = getenv('APPDATA') . '\\Code\\User\\History';

        // ═══════════════════════════════════════════════
        // 1. Restauration depuis VS Code History
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 1/4 — Restauration depuis VS Code History');

        $restores = [
            [
                'source' => $historyPath . '\-784c8862\3Ma3.php',
                'dest'   => app_path('Http/Requests/Formateur/StoreFormateurRequest.php'),
                'name'   => 'StoreFormateurRequest.php',
            ],
            [
                'source' => $historyPath . '\4d49ca85\1VP8.php',
                'dest'   => app_path('Http/Requests/Formateur/UpdateFormateurRequest.php'),
                'name'   => 'UpdateFormateurRequest.php',
            ],
            [
                'source' => $historyPath . '\60fb32d7\uDGp.php',
                'dest'   => app_path('Http/Requests/Etablissement/StoreEtablissementRequest.php'),
                'name'   => 'StoreEtablissementRequest.php',
            ],
            [
                'source' => $historyPath . '\-10984887\WWt0.php',
                'dest'   => app_path('Http/Requests/Etablissement/UpdateEtablissementRequest.php'),
                'name'   => 'UpdateEtablissementRequest.php',
            ],
            [
                'source' => $historyPath . '\-4742767\kx9L.php',
                'dest'   => app_path('Http/Requests/Auth/Admin/LoginAdminRequest.php'),
                'name'   => 'LoginAdminRequest.php',
            ],
            [
                'source' => $historyPath . '\-74a98279\bnnI.php',
                'dest'   => app_path('Http/Requests/Auth/Admin/RegisterAdminRequest.php'),
                'name'   => 'RegisterAdminRequest.php',
            ],
        ];

        foreach ($restores as $r) {
            if (!File::exists($r['source'])) {
                $this->warn("   ⏭️  {$r['name']} — source introuvable");
                continue;
            }

            $dir = dirname($r['dest']);
            if (!File::exists($dir)) {
                File::makeDirectory($dir, 0755, true);
            }

            File::copy($r['source'], $r['dest']);
            $size = File::size($r['dest']);

            if ($size > 0) {
                $this->info("   ✅ {$r['name']} restauré ({$size} octets)");
            } else {
                $this->warn("   ⚠️  {$r['name']} restauré mais VIDE");
            }
        }

        // ═══════════════════════════════════════════════
        // 2. Création des Form Requests manquants
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 2/4 — Création des Form Requests manquants');

        $files = [
            'app/Http/Requests/Auth/Formateur/LoginFormateurRequest.php'    => $this->loginFormateur(),
            'app/Http/Requests/Auth/Formateur/RegisterFormateurRequest.php' => $this->registerFormateur(),
            'app/Http/Requests/Filiere/StoreFiliereRequest.php'             => $this->storeFiliere(),
            'app/Http/Requests/Filiere/UpdateFiliereRequest.php'            => $this->updateFiliere(),
            'app/Http/Requests/Niveau/StoreNiveauRequest.php'               => $this->storeNiveau(),
            'app/Http/Requests/Niveau/UpdateNiveauRequest.php'              => $this->updateNiveau(),
            'app/Http/Requests/Secteur/StoreSecteurRequest.php'             => $this->storeSecteur(),
            'app/Http/Requests/Secteur/UpdateSecteurRequest.php'            => $this->updateSecteur(),
            'app/Http/Requests/Session/StoreSessionRequest.php'             => $this->storeSession(),
            'app/Http/Requests/Session/UpdateSessionRequest.php'            => $this->updateSession(),
        ];

        foreach ($files as $relPath => $content) {
            $path = base_path($relPath);
            $dir = dirname($path);

            if (!File::exists($dir)) {
                File::makeDirectory($dir, 0755, true);
            }

            // Backup si le fichier existe déjà et non vide
            if (File::exists($path) && File::size($path) > 0) {
                File::copy($path, $path . '.bak.' . date('Y-m-d_His'));
            }

            File::put($path, $content);
            $this->info('   ✅ ' . basename($relPath) . ' créé (' . File::size($path) . ' octets)');
        }

        // ═══════════════════════════════════════════════
        // 3. Vérification
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 3/4 — Vérification finale');

        $checkFiles = [
            'app/Infrastructure/Persistence/Eloquent/Models/UserModel.php',
            'app/Http/Requests/Formateur/StoreFormateurRequest.php',
            'app/Http/Requests/Formateur/UpdateFormateurRequest.php',
            'app/Http/Requests/Auth/Formateur/LoginFormateurRequest.php',
            'app/Http/Requests/Auth/Formateur/RegisterFormateurRequest.php',
            'app/Http/Requests/Filiere/StoreFiliereRequest.php',
            'app/Http/Requests/Filiere/UpdateFiliereRequest.php',
            'app/Http/Requests/Niveau/StoreNiveauRequest.php',
            'app/Http/Requests/Niveau/UpdateNiveauRequest.php',
            'app/Http/Requests/Secteur/StoreSecteurRequest.php',
            'app/Http/Requests/Secteur/UpdateSecteurRequest.php',
            'app/Http/Requests/Session/StoreSessionRequest.php',
            'app/Http/Requests/Session/UpdateSessionRequest.php',
        ];

        $ok = 0;
        $ko = 0;

        foreach ($checkFiles as $f) {
            $path = base_path($f);
            if (File::exists($path) && File::size($path) > 0) {
                $this->info('   ✅ ' . basename($f) . ' : ' . File::size($path) . ' octets');
                $ok++;
            } else {
                $this->error('   ❌ ' . basename($f) . ' : VIDE ou INTROUVABLE');
                $ko++;
            }
        }

        // ═══════════════════════════════════════════════
        // 4. Vidage des caches
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 4/4 — Vidage des caches');
        Artisan::call('optimize:clear');
        Artisan::call('view:clear');
        Artisan::call('route:clear');
        Artisan::call('config:clear');
        $this->info('   ✅ Caches vidés');

        // ═══════════════════════════════════════════════
        // Résumé
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('╔══════════════════════════════════════════════════════════╗');
        $this->line("║   ✅ {$ok} fichiers OK | ❌ {$ko} fichiers KO");
        $this->line('╚══════════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Étapes suivantes :');
        $this->line('   1. php artisan audit:full');
        $this->line('   2. Tester /admin/formateurs dans le navigateur');

        return $ko > 0 ? self::FAILURE : self::SUCCESS;
    }

    // ═══════════════════════════════════════════════════════
    // Templates des fichiers
    // ═══════════════════════════════════════════════════════

