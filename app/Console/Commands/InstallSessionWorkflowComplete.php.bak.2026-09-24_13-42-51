<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class InstallSessionWorkflowComplete extends Command
{
    protected $signature = 'project:install-session-workflow-complete
                            {--backup : Sauvegarder les fichiers (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Installe le workflow complet des demandes de session (historique + approbation)';

    public function handle(): int
    {
        $this->info("🔄 Installation du workflow complet des sessions");
        $this->newLine();

        if (!$this->option('force') && !$this->confirm('Installer le workflow ?', true)) {
            $this->warn('Annulé.');
            return self::FAILURE;
        }

        // ============================================================
        // 1. Vue formateur sessions/index (avec historique demandes)
        // ============================================================
        $this->writeFile(
            'resources/views/formateur/sessions/index.blade.php',
            $this->getFormateurSessionsView()
        );
        $this->line("  ✅ Vue formateur/sessions/index.blade.php");

        // ============================================================
        // 2. Contrôleur formateur SessionController
        // ============================================================
        $this->writeFile(
            'app/Http/Controllers/Formateur/SessionController.php',
            $this->getFormateurSessionController()
        );
        $this->line("  ✅ SessionController (formateur)");

        // ============================================================
        // 3. Contrôleur formateur DemandeSessionController
        // ============================================================
        $this->writeFile(
            'app/Http/Controllers/Formateur/DemandeSessionController.php',
            $this->getFormateurDemandeController()
        );
        $this->line("  ✅ DemandeSessionController (formateur)");

        // ============================================================
        // 4. Contrôleur admin DemandeSessionAdminController
        // ============================================================
        $this->writeFile(
            'app/Http/Controllers/Admin/DemandeSessionAdminController.php',
            $this->getAdminDemandeController()
        );
        $this->line("  ✅ DemandeSessionAdminController (admin)");

        // ============================================================
        // 5. Migration : ajout champ statut source
        // ============================================================
        $this->writeFile(
            'database/migrations/' . date('Y_m_d_His') . '_add_source_to_sessions.php',
            $this->getMigration()
        );
        $this->line("  ✅ Migration ajout source sessions");

        // ============================================================
        // 6. Migration BDD
        // ============================================================
        $this->newLine();
        $this->info("🗄️  Migration de la base...");
        $this->call('migrate', ['--force' => true]);

        // ============================================================
        // 7. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');
        $this->call('route:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : workflow complet installé");
        $this->line("  • /formateur/sessions : historique des demandes + sessions");
        $this->line("  • /admin/demandes-sessions : approbation admin");
        $this->line("  • Approuvé → session active");
        $this->line("  • Refusé → session suspendue");

        return self::SUCCESS;
    }

    protected function writeFile(string $relativePath, string $content): void
    {
        $fullPath = base_path($relativePath);

        if (!File::exists(dirname($fullPath))) {
            File::makeDirectory(dirname($fullPath), 0755, true);
        }

        if ($this->option('backup') && File::exists($fullPath)) {
            File::copy($fullPath, $fullPath . '.bak.' . date('Y-m-d_H-i-s'));
        }

        File::put($fullPath, $content);
    }

