<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixNotificationsZIndex extends Command
{
    protected $signature = 'project:fix-notifications-zindex
                            {--backup : Sauvegarder le fichier (.bak)}
                            {--force : Écraser sans confirmation}';

    protected $description = 'Augmente le z-index du header et du dropdown de notifications admin';

    public function handle(): int
    {
        $this->info("🎯 Correction du z-index des notifications");
        $this->newLine();

        $path = 'resources/views/layouts/admin.blade.php';
        $fullPath = base_path($path);

        if (!File::exists($fullPath)) {
            $this->error("❌ Fichier introuvable : {$path}");
            return self::FAILURE;
        }

        if ($this->option('backup')) {
            $backupPath = $fullPath . '.bak.' . date('Y-m-d_H-i-s');
            File::copy($fullPath, $backupPath);
            $this->line("  💾 Backup : " . basename($backupPath));
        }

        $content = File::get($fullPath);
        $originalSize = strlen($content);

        // ============================================================
        // 1. Header : z-30 → z-[100]
        // ============================================================
        $content = str_replace(
            'flex items-center justify-between px-6 lg:px-10 z-30',
            'flex items-center justify-between px-6 lg:px-10 z-[100]',
            $content
        );

        // Fallback si la classe est différente
        $content = preg_replace(
            '/(<header[^>]*class="[^"]*)\bz-30\b([^"]*")/',
            '$1z-[100]$2',
            $content
        );

        $this->line("  ✅ Header : z-index augmenté à 100");

        // ============================================================
        // 2. Dropdown : ajouter inline style + z-index élevé
        // ============================================================
        $dropdownPattern = '/<div id="notifications-dropdown"\s*class="([^"]*?)"/';

        if (preg_match($dropdownPattern, $content, $matches)) {
            $oldClass = $matches[1];

            // Nettoyer les anciennes classes z-*
            $newClass = preg_replace('/\bz-\d+\b/', '', $oldClass);
            $newClass = preg_replace('/\bz-\[\d+\]\b/', '', $newClass);
            $newClass = trim(preg_replace('/\s+/', ' ', $newClass));

            // Remplacer par la nouvelle version avec inline style
            $content = str_replace(
                '<div id="notifications-dropdown" class="' . $oldClass . '"',
                '<div id="notifications-dropdown" '
                    . 'class="' . $newClass . ' z-[9999]" '
                    . 'style="position: absolute !important; z-index: 9999 !important;"',
                $content
            );

            $this->line("  ✅ Dropdown : z-index 9999 + position absolute");
        } else {
            $this->warn("  ⚠️  Dropdown non trouvé avec le pattern standard");

            // Fallback : chercher par l'ID seul
            $content = str_replace(
                '<div id="notifications-dropdown"',
                '<div id="notifications-dropdown" style="position: absolute !important; z-index: 9999 !important;"',
                $content
            );
            $this->line("  ✅ Dropdown : style inline ajouté (fallback)");
        }

        // ============================================================
        // 3. Container relatif du dropdown
        // ============================================================
        // Le parent .relative doit aussi avoir un z-index élevé
        $content = str_replace(
            '<div class="relative">' . "\n" . '                <button onclick="toggleNotifications()"',
            '<div class="relative" style="z-index: 9999;">' . "\n" . '                <button onclick="toggleNotifications()"',
            $content
        );

        $this->line("  ✅ Container relatif : z-index 9999");

        // ============================================================
        // 4. Ajouter CSS global pour forcer
        // ============================================================
        $customCss = <<<'CSS'

    <style>
        /* =========================================================
           FORCE LE DROPDOWN AU-DESSUS DE TOUT
        ========================================================= */
        #notifications-dropdown {
            z-index: 99999 !important;
            position: absolute !important;
        }

        /* Header doit être au-dessus du contenu */
        body > div > header,
        body > div[data-sidebar-width] > header {
            z-index: 1000 !important;
            position: sticky;
        }

        /* Empêcher le contenu de passer devant */
        body > div[data-sidebar-width] > div {
            position: relative;
            z-index: 1;
        }
    </style>

CSS;

        // Insérer avant </head>
        if (!str_contains($content, 'FORCE LE DROPDOWN AU-DESSUS DE TOUT')) {
            $content = str_replace('</head>', $customCss . '</head>', $content);
            $this->line("  ✅ CSS global ajouté");
        }

        // ============================================================
        // 5. Écrire
        // ============================================================
        File::put($fullPath, $content);

        $newSize = strlen($content);
        $diff = $newSize - $originalSize;
        $this->line("  ✅ {$path} mis à jour (+{$diff} octets)");

        // ============================================================
        // 6. Nettoyer les caches
        // ============================================================
        $this->newLine();
        $this->info("🧹 Nettoyage des caches...");
        $this->call('view:clear');
        $this->call('cache:clear');

        $this->newLine();
        $this->info("✨ SUCCÈS : dropdown passe au-dessus");
        $this->line("  • Header : z-index 1000");
        $this->line("  • Dropdown : z-index 99999");
        $this->line("  • Container : z-index 9999");
        $this->line("  • CSS global ajouté");

        return self::SUCCESS;
    }
}