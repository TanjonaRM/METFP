<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class AutoWireFormateurModal extends Command
{
    protected $signature = 'fix:wire-formateur-modal
                            {--dry-run : Simule sans modifier les fichiers}';

    protected $description = 'Insère automatiquement @include modal + @stack(scripts) dans les vues';

    public function handle(): int
    {
        $dryRun = $this->option('dry-run');

        if ($dryRun) {
            $this->warn('🔍 MODE DRY-RUN : aucune modification ne sera appliquée');
            $this->newLine();
        }

        // ─────────────────────────────────────────────
        // ÉTAPE 1 : index.blade.php
        // ─────────────────────────────────────────────
        $this->line('═══ ÉTAPE 1/2 : index.blade.php ═══');
        $indexPath = resource_path('views/admin/formateurs/index.blade.php');

        if (!File::exists($indexPath)) {
            $this->error("❌ Fichier introuvable : {$indexPath}");
            return self::FAILURE;
        }

        $indexContent = File::get($indexPath);
        $includeLine  = "@include('admin.formateurs.partials.modal-create')";

        // Vérifier si déjà présent
        if (str_contains($indexContent, $includeLine)) {
            $this->info("✅ @include déjà présent → rien à faire");
        } else {
            // Trouver le DERNIER @endsection
            $lastEnd = strrpos($indexContent, '@endsection');

            if ($lastEnd === false) {
                $this->error("❌ Aucun @endsection trouvé dans index.blade.php");
                $this->warn("⚠️  Ajoutez-le manuellement à la fin du fichier :");
                $this->line("   {$includeLine}");
            } else {
                // Insérer AVANT le @endsection
                $newContent = substr($indexContent, 0, $lastEnd)
                    . "\n" . $includeLine . "\n"
                    . substr($indexContent, $lastEnd);

                if ($dryRun) {
                    $this->info("🔍 [DRY-RUN] @include serait inséré avant le dernier @endsection");
                } else {
                    // Backup
                    $backup = $indexPath . '.bak.' . date('Y-m-d_His');
                    File::copy($indexPath, $backup);
                    File::put($indexPath, $newContent);
                    $this->info("✅ @include inséré dans index.blade.php");
                    $this->line("   💾 Backup : " . basename($backup));
                }
            }
        }

        $this->newLine();

        // ─────────────────────────────────────────────
        // ÉTAPE 2 : layouts/admin.blade.php → @stack('scripts')
        // ─────────────────────────────────────────────
        $this->line('═══ ÉTAPE 2/2 : layouts/admin.blade.php ═══');
        $layoutPath = resource_path('views/layouts/admin.blade.php');

        if (!File::exists($layoutPath)) {
            $this->error("❌ Fichier introuvable : {$layoutPath}");
            return self::FAILURE;
        }

        $layoutContent = File::get($layoutPath);

        // Vérifier si @stack('scripts') existe déjà
        if (preg_match("/@stack\(\s*['\"]scripts['\"]\s*\)/", $layoutContent)) {
            $this->info("✅ @stack('scripts') déjà présent → rien à faire");
        } else {
            // Trouver </body>
            $bodyPos = strripos($layoutContent, '</body>');

            if ($bodyPos === false) {
                $this->error("❌ Aucune balise </body> trouvée dans admin.blade.php");
                $this->warn("⚠️  Ajoutez manuellement avant </body> :");
                $this->line("   @stack('scripts')");
            } else {
                // Insérer AVANT </body>
                $newContent = substr($layoutContent, 0, $bodyPos)
                    . "    @stack('scripts')\n"
                    . substr($layoutContent, $bodyPos);

                if ($dryRun) {
                    $this->info("🔍 [DRY-RUN] @stack('scripts') serait inséré avant </body>");
                } else {
                    // Backup
                    $backup = $layoutPath . '.bak.' . date('Y-m-d_His');
                    File::copy($layoutPath, $backup);
                    File::put($layoutPath, $newContent);
                    $this->info("✅ @stack('scripts') inséré dans layouts/admin.blade.php");
                    $this->line("   💾 Backup : " . basename($backup));
                }
            }
        }

        $this->newLine();

        // ─────────────────────────────────────────────
        // RÉSUMÉ
        // ─────────────────────────────────────────────
        $this->line('══════════════════════════════════════════');
        if ($dryRun) {
            $this->warn('🔍 DRY-RUN terminé. Relancez sans --dry-run pour appliquer.');
        } else {
            $this->info('🎉 Câblage terminé !');
            $this->newLine();
            $this->line('👉 Étapes suivantes :');
            $this->line('   1. php artisan view:clear');
            $this->line('   2. php artisan optimize:clear');
            $this->line('   3. Recharger /admin/formateurs (Ctrl+F5)');
        }

        return self::SUCCESS;
    }
}