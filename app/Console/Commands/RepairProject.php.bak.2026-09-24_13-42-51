use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Facades\Artisan;

class RepairProject extends Command
{
    protected $signature = 'repair:project
                            {--skip-backup : Ne pas créer de .bak}
                            {--force : Écrase les fichiers existants}';

    protected $description = 'Répare les controllers/vues cassés sans changer le design';

    public function handle(): int
    {
        $this->line('');
        $this->line('╔════════════════════════════════════════════════════╗');
        $this->line('║   🔧 RÉPARATION AUTOMATIQUE DU PROJET              ║');
        $this->line('╚════════════════════════════════════════════════════╝');
        $this->line('');

        // ─────────────────────────────────────────────
        // 1. Réparer FormateurController
        // ─────────────────────────────────────────────
        $this->line('▶ 1/6 — FormateurController');
        $this->repairFormateurController();
        $this->line('');

        // ─────────────────────────────────────────────
        // 2. Créer le partial _form.blade.php
        // ─────────────────────────────────────────────
        $this->line('▶ 2/6 — Partial _form.blade.php');
        $this->createFormPartial();
        $this->line('');

        // ─────────────────────────────────────────────
        // 3. Créer les vues create/edit/show
        // ─────────────────────────────────────────────
        $this->line('▶ 3/6 — Vues formateurs');
        $this->createFormateurViews();
        $this->line('');

        // ─────────────────────────────────────────────
        // 4. Ajouter les méthodes manquantes
        // ─────────────────────────────────────────────
        $this->line('▶ 4/6 — Méthodes manquantes');
        $this->addMissingMethods();
        $this->line('');

        // ─────────────────────────────────────────────
        // 5. Vider les caches
        // ─────────────────────────────────────────────
        $this->line('▶ 5/6 — Vidage des caches');
        Artisan::call('optimize:clear');
        Artisan::call('view:clear');
        Artisan::call('route:clear');
        Artisan::call('config:clear');
        $this->info('✅ Caches vidés');
        $this->line('');

        // ─────────────────────────────────────────────
        // 6. Test live
        // ─────────────────────────────────────────────
        $this->line('▶ 6/6 — Test live de la route AJAX');
        $this->testAjaxRoute();
        $this->line('');

        $this->line('╔════════════════════════════════════════════════════╗');
        $this->line('║              🎉 RÉPARATION TERMINÉE                ║');
        $this->line('╚════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Testez : http://localhost:8000/admin/formateurs');
        $this->line('   Ouvrez F12 → cliquez "Ajouter un formateur"');
        $this->line('   Attendu : 🔵 Ouverture modal + 📦 Formulaire chargé');

        return self::SUCCESS;
    }

    // ═════════════════════════════════════════════════
    // 1. FORMATEUR CONTROLLER COMPLET
    // ═════════════════════════════════════════════════
    private function repairFormateurController(): void
    {
        $path = app_path('Http/Controllers/Admin/FormateurController.php');

        // Backup
        if (!$this->option('skip-backup') && File::exists($path)) {
            $bak = $path . '.bak.' . date('Y-m-d_His');
            File::copy($path, $bak);
            $this->line("   💾 Backup : " . basename($bak));
        }

        File::put($path, $this->getFormateurControllerCode());
        $this->info('✅ FormateurController réparé (9 méthodes)');
    }

    private function getFormateurControllerCode(): string
    {
        return <<<'PHP'
<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Http\Requests\Formateur\StoreFormateurRequest;
use App\Http\Requests\Formateur\UpdateFormateurRequest;
use Illuminate\Http\Request;
use Infrastructure\Persistence\Eloquent\Models\EtablissementModel;
use Infrastructure\Persistence\Eloquent\Models\FiliereModel;
use Infrastructure\Persistence\Eloquent\Models\FormateurModel;
use Infrastructure\Persistence\Eloquent\Models\HistoriqueFormateurModel;

class FormateurController extends Controller
{
    // ═══════════════════════════════════════════════════════
    // INDEX — liste des formateurs
    // ═══════════════════════════════════════════════════════
    public function index(Request $request)
    {
        $formateurs = FormateurModel::with(['etablissement', 'filiere'])
            ->when($request->filled('search'), function ($q) use ($request) {
                $s = $request->search;
                $q->where(function ($qq) use ($s) {
                    $qq->where('nom', 'like', "%{$s}%")
                       ->orWhere('prenom', 'like', "%{$s}%")
                       ->orWhere('matricule', 'like', "%{$s}%");
                });
            })
            ->when($request->filled('etablissement_id'), fn($q) => $q->where('etablissement_id', $request->etablissement_id))
            ->when($request->filled('statut'), fn($q) => $q->where('statut', $request->statut))
            ->orderBy('nom')
            ->paginate(15)
            ->withQueryString();

        $etablissements = EtablissementModel::orderBy('nom')->get();
        $filieres       = FiliereModel::orderBy('libelle')->get();

        return view('admin.formateurs.index', compact('formateurs', 'etablissements', 'filieres'));
    }

    // ═══════════════════════════════════════════════════════
    // CREATE — formulaire (JSON si AJAX, sinon vue)
    // ═══════════════════════════════════════════════════════
    public function create(Request $request)
    {
        $etablissements = EtablissementModel::orderBy('nom')->get();
        $filieres       = FiliereModel::orderBy('libelle')->get();

        // Requête AJAX → renvoyer JSON avec le HTML du formulaire
        if ($request->ajax() || $request->wantsJson()) {
            $html = view('admin.formateurs.partials._form', compact('etablissements', 'filieres'))->render();
            return response()->json(['html' => $html]);
        }

        return view('admin.formateurs.create', compact('etablissements', 'filieres'));
    }

    // ═══════════════════════════════════════════════════════
    // STORE — enregistrement
    // ═══════════════════════════════════════════════════════
    public function store(StoreFormateurRequest $request)
    {
        $data = $request->validated();

        $formateur = FormateurModel::create($data);

        // Historique
        HistoriqueFormateurModel::create([
            'formateur_id' => $formateur->id,
            'action'       => 'creation',
            'details'      => 'Formateur créé : ' . $formateur->nom . ' ' . $formateur->prenom,
            'user_id'      => auth('admin')->id(),
        ]);

        // Réponse AJAX
        if ($request->ajax() || $request->wantsJson()) {
            return response()->json([
                'success'  => true,
                'message'  => 'Formateur créé avec succès.',
                'redirect' => route('admin.formateurs.index'),
            ]);
        }

        return redirect()
            ->route('admin.formateurs.index')
            ->with('success', 'Formateur créé avec succès.');
    }

    // ═══════════════════════════════════════════════════════
    // SHOW — détail
    // ═══════════════════════════════════════════════════════
    public function show(int $id)
    {
        $formateur = FormateurModel::with([
            'etablissement',
            'filiere',
            'historiques',
        ])->findOrFail($id);

        return view('admin.formateurs.show', compact('formateur'));
    }

    // ═══════════════════════════════════════════════════════
    // EDIT — formulaire d'édition
    // ═══════════════════════════════════════════════════════
    public function edit(int $id)
    {
        $formateur      = FormateurModel::findOrFail($id);
        $etablissements = EtablissementModel::orderBy('nom')->get();
        $filieres       = FiliereModel::orderBy('libelle')->get();

        return view('admin.formateurs.edit', compact('formateur', 'etablissements', 'filieres'));
    }

    // ═══════════════════════════════════════════════════════
    // UPDATE — mise à jour
    // ═══════════════════════════════════════════════════════
    public function update(UpdateFormateurRequest $request, int $id)
    {
        $formateur = FormateurModel::findOrFail($id);
        $data      = $request->validated();

        $formateur->update($data);

        HistoriqueFormateurModel::create([
            'formateur_id' => $formateur->id,
            'action'       => 'modification',
            'details'      => 'Formateur modifié : ' . $formateur->nom . ' ' . $formateur->prenom,
            'user_id'      => auth('admin')->id(),
        ]);

        if ($request->ajax() || $request->wantsJson()) {
            return response()->json([
                'success'  => true,
                'message'  => 'Formateur mis à jour.',
                'redirect' => route('admin.formateurs.index'),
            ]);
        }

        return redirect()
            ->route('admin.formateurs.index')
            ->with('success', 'Formateur mis à jour.');
    }

    // ═══════════════════════════════════════════════════════
    // DESTROY — suppression
    // ═══════════════════════════════════════════════════════
    public function destroy(int $id)
    {
        $formateur = FormateurModel::findOrFail($id);

        HistoriqueFormateurModel::create([
            'formateur_id' => $formateur->id,
            'action'       => 'suppression',
            'details'      => 'Formateur supprimé : ' . $formateur->nom . ' ' . $formateur->prenom,
            'user_id'      => auth('admin')->id(),
        ]);

        $formateur->delete();

        if (request()->ajax() || request()->wantsJson()) {
            return response()->json([
                'success'  => true,
                'message'  => 'Formateur supprimé.',
                'redirect' => route('admin.formateurs.index'),
            ]);
        }

        return redirect()
            ->route('admin.formateurs.index')
            ->with('success', 'Formateur supprimé.');
    }
}
PHP;
    }

    // ═════════════════════════════════════════════════
    // 2. PARTIAL _form.blade.php
    // ═════════════════════════════════════════════════
    private function createFormPartial(): void
    {
        $dir = resource_path('views/admin/formateurs/partials');
        if (!File::exists($dir)) {
            File::makeDirectory($dir, 0755, true);
        }

        $path = $dir . '/_form.blade.php';

        if (File::exists($path) && !$this->option('force')) {
            $this->warn('⏭️  Existe déjà (utilisez --force pour écraser)');
            return;
        }

        File::put($path, $this->getFormPartialCode());
        $this->info('✅ partials/_form.blade.php créé');
    }

