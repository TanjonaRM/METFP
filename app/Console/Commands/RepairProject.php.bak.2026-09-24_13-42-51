    private function testAjaxRoute(): void
    {
        try {
            $request = \Illuminate\Http\Request::create(
                '/admin/formateurs/create',
                'GET', [], [], [],
                ['HTTP_X-REQUESTED-WITH' => 'XMLHttpRequest', 'HTTP_ACCEPT' => 'application/json']
            );
            $response = app()->handle($request);
            $json = json_decode($response->getContent(), true);

            if (isset($json['html'])) {
                $this->info('✅ Route AJAX OK — HTML : ' . strlen($json['html']) . ' octets');
            } else {
                $this->error('❌ Route AJAX ne renvoie pas de "html"');
                $this->line('   Body : ' . substr($response->getContent(), 0, 300));
            }
        } catch (\Throwable $e) {
            $this->error('❌ Erreur : ' . $e->getMessage());
        }
    }
