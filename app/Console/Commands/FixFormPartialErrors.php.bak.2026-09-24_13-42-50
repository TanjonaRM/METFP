<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\File;

class FixFormPartialErrors extends Command
{
    protected $signature = 'fix:form-partial';
    protected $description = 'Corrige le partial _form (retire <form> + gère $errors) et le controller';

    public function handle(): int
    {
        // ═══════════════════════════════════════════════
        // 1. Corriger le partial _form.blade.php
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 1/3 — Correction du partial _form.blade.php');

        $partialPath = resource_path('views/admin/formateurs/partials/_form.blade.php');
        if (!File::exists($partialPath)) {
            $this->error('   ❌ Fichier introuvable : ' . $partialPath);
            return self::FAILURE;
        }

        // Backup
        File::copy($partialPath, $partialPath . '.bak.' . date('Y-m-d_His'));
        $this->line('   💾 Backup créé');

        // Écraser avec la version corrigée
        File::put($partialPath, $this->getCorrectedPartial());
        $this->info('   ✅ Partial corrigé (sans <form>, sans @error)');

        // ═══════════════════════════════════════════════
        // 2. Corriger FormateurController@create
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 2/3 — Correction FormateurController@create');

        $ctrlPath = app_path('Http/Controllers/Admin/FormateurController.php');
        if (!File::exists($ctrlPath)) {
            $this->error('   ❌ Controller introuvable');
            return self::FAILURE;
        }

        $ctrl = File::get($ctrlPath);

        // Backup
        File::copy($ctrlPath, $ctrlPath . '.bak.' . date('Y-m-d_His'));
        $this->line('   💾 Backup créé');

        // Remplacer la méthode create() complète
        $newCreate = $this->getNewCreateMethod();

        if (preg_match('/public function create\s*\([^)]*\)\s*\{.*?\n    \}/s', $ctrl, $m)) {
            $ctrl = str_replace($m[0], $newCreate, $ctrl);
            File::put($ctrlPath, $ctrl);
            $this->info('   ✅ create() corrigée (injecte $errors + $etablissements + $filieres)');
        } else {
            $this->warn('   ⚠️  Méthode create() introuvable — ajout à la main requis');
        }

        // ═══════════════════════════════════════════════
        // 3. Test de rendu
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('▶ 3/3 — Test de rendu du partial');

        try {
            $etablissements = \Infrastructure\Persistence\Eloquent\Models\EtablissementModel::orderBy('nom')->limit(3)->get();
            $filieres = \Infrastructure\Persistence\Eloquent\Models\FiliereModel::orderBy('libelle')->limit(3)->get();
            $errors = new \Illuminate\Support\ViewErrorBag();

            $html = view('admin.formateurs.partials._form', compact('etablissements', 'filieres', 'errors'))->render();

            $this->info('   ✅ Rendu OK : ' . strlen($html) . ' octets');

            if (str_contains($html, 'name="matricule"')) {
                $this->info('   ✅ Contient input matricule');
            }
            if (str_contains($html, '<form')) {
                $this->warn('   ⚠️  Contient un <form> — sera problématique si imbriqué !');
            } else {
                $this->info('   ✅ Aucun <form> (correct pour un partial)');
            }
        } catch (\Throwable $e) {
            $this->error('   ❌ Erreur : ' . $e->getMessage());
            return self::FAILURE;
        }

        // ═══════════════════════════════════════════════
        // Résumé
        // ═══════════════════════════════════════════════
        $this->line('');
        $this->line('╔════════════════════════════════════════════════════╗');
        $this->line('║   🎉 CORRECTION TERMINÉE                           ║');
        $this->line('╚════════════════════════════════════════════════════╝');
        $this->line('');
        $this->line('👉 Prochaines étapes :');
        $this->line('   1. php artisan view:clear');
        $this->line('   2. php artisan optimize:clear');
        $this->line('   3. Tester dans le navigateur');

        return self::SUCCESS;
    }

